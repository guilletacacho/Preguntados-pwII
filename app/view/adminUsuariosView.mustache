<main class="moderador-shell">
    {{> navegacionLateral}}
    <div class="admin-wrap">
        {{> adminEncabezado}}

        <form class="moderador-filtros admin-filtros-usuarios" method="get" action="{{basePath}}/admin/usuarios" role="search" aria-label="Filtros de usuarios" data-admin-usuarios-form data-ajax-url="{{basePath}}/admin/usuariosAjax" data-base-path="{{basePath}}">
            <label class="admin-filtro-busqueda">
                Buscar usuarios
                <input type="search" name="busqueda" value="{{filtros.busqueda}}" placeholder="Usuario, nombre o correo" maxlength="100" autocomplete="off">
            </label>
            <label>
                Rol
                <select name="rol">
                    {{#roles}}
                        <option value="{{value}}" {{#seleccionado}}selected{{/seleccionado}}>{{label}}</option>
                    {{/roles}}
                </select>
            </label>
            <label>
                Estado de la cuenta
                <select name="estado">
                    {{#estados}}
                        <option value="{{value}}" {{#seleccionado}}selected{{/seleccionado}}>{{label}}</option>
                    {{/estados}}
                </select>
            </label>
            <label>
                Alta desde
                <input type="date" name="desde" value="{{filtros.desde}}">
            </label>
            <label>
                Alta hasta
                <input type="date" name="hasta" value="{{filtros.hasta}}">
            </label>
            <label>
                Puntos mínimos
                <input type="number" name="puntosMinimos" value="{{filtros.puntosMinimos}}" min="0" step="1" placeholder="Sin mínimo">
            </label>
            <label>
                Ordenar por
                <select name="orden">
                    {{#ordenes}}
                        <option value="{{value}}" {{#seleccionado}}selected{{/seleccionado}}>{{label}}</option>
                    {{/ordenes}}
                </select>
            </label>
            <div class="admin-filtros-acciones">
                <a class="moderador-boton moderador-boton-cancelar" href="{{basePath}}/admin/usuarios" data-admin-limpiar>Limpiar</a>
                <button class="moderador-boton" type="submit">Filtrar</button>
            </div>
        </form>
        <p class="moderador-mensaje moderador-mensaje-error" role="alert" data-admin-error-fechas{{^errorFechas}} hidden{{/errorFechas}}>La fecha desde debe ser anterior o igual a la fecha hasta.</p>
        <p class="moderador-mensaje moderador-mensaje-error" role="alert" data-admin-ajax-error hidden></p>

        <div class="moderador-tabla-contenedor admin-tabla-usuarios-contenedor" data-admin-tabla-contenedor>
            <table class="moderador-tabla-preguntas admin-tabla-usuarios">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Nombre y correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Puntos</th>
                        <th>Fecha de alta</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody data-admin-usuarios-tbody>
                    {{#usuarios}}
                        <tr>
                            <td><strong>{{usuario}}</strong></td>
                            <td>{{nombre}}<br><span class="moderador-item-meta">{{email}}</span></td>
                            <td>
                                <span class="moderador-badge {{#esAdmin}}moderador-badge-alerta{{/esAdmin}} {{#esModerador}}moderador-badge-verde{{/esModerador}}">{{rol}}</span>
                            </td>
                            <td>
                                {{#verificado}}Verificado{{/verificado}}{{^verificado}}Sin verificar{{/verificado}}
                                {{#bloqueado}}<br><span class="admin-estado-bloqueado">Bloqueado</span>{{/bloqueado}}
                            </td>
                            <td>{{puntos}}</td>
                            <td>{{#fechaAlta}}{{fechaAlta}}{{/fechaAlta}}{{^fechaAlta}}<span class="moderador-item-meta">Sin registro</span>{{/fechaAlta}}</td>
                            <td>
                                <div class="admin-usuario-acciones">
                                    <a class="moderador-boton moderador-boton-corregir admin-accion-icono" href="{{basePath}}/admin/editarUsuario?id={{id}}" title="Editar" aria-label="Editar a {{usuario}}">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                                    </a>
                                    {{^esAdmin}}
                                        {{^bloqueado}}
                                            <button class="moderador-boton admin-boton-bloqueo admin-accion-icono" type="button" title="Bloquear" aria-haspopup="dialog" aria-label="Bloquear a {{usuario}}" data-admin-bloqueo data-id="{{id}}" data-usuario="{{usuario}}">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
                                            </button>
                                        {{/bloqueado}}
                                        {{#bloqueado}}
                                            <form method="post" action="{{basePath}}/admin/cambiarBloqueoUsuario?{{queryFiltros}}&amp;pagina={{pagina}}">
                                                <input type="hidden" name="id" value="{{id}}">
                                                <input type="hidden" name="csrf_token" value="{{csrfToken}}">
                                                <button class="moderador-boton admin-boton-desbloqueo admin-accion-icono" type="submit" name="bloquear" value="0" title="Desbloquear" aria-label="Desbloquear a {{usuario}}">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 7.46-2"></path></svg>
                                                </button>
                                            </form>
                                        {{/bloqueado}}
                                        <form method="post" action="{{basePath}}/admin/bajaUsuario?{{queryFiltros}}&amp;pagina={{pagina}}" onsubmit="return confirm('¿Eliminar esta cuenta de forma permanente?');">
                                            <input type="hidden" name="id" value="{{id}}">
                                            <input type="hidden" name="csrf_token" value="{{csrfToken}}">
                                            <button class="moderador-boton moderador-boton-descartar admin-accion-icono" type="submit" title="Eliminar" aria-label="Eliminar a {{usuario}}">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg>
                                            </button>
                                        </form>
                                    {{/esAdmin}}
                                </div>
                            </td>
                        </tr>
                    {{/usuarios}}
                    {{^usuarios}}
                        <tr><td colspan="7" class="moderador-vacio">No hay usuarios con esos filtros.</td></tr>
                    {{/usuarios}}
                </tbody>
            </table>
        </div>

        <div class="moderador-paginacion" data-admin-paginacion>
            <span data-admin-paginacion-resumen aria-live="polite">Página {{pagina}} de {{paginas}} · {{totalUsuarios}} usuarios</span>
            <nav aria-label="Páginas de usuarios" data-admin-paginacion-nav>
                {{#hayPaginaAnterior}}
                    <a href="{{basePath}}/admin/usuarios?{{queryFiltros}}&amp;pagina={{paginaAnterior}}" data-pagina="{{paginaAnterior}}">Anterior</a>
                {{/hayPaginaAnterior}}
                {{^hayPaginaAnterior}}
                    <span class="paginacion-deshabilitada">Anterior</span>
                {{/hayPaginaAnterior}}
                {{#hayPaginaSiguiente}}
                    <a href="{{basePath}}/admin/usuarios?{{queryFiltros}}&amp;pagina={{paginaSiguiente}}" data-pagina="{{paginaSiguiente}}">Siguiente</a>
                {{/hayPaginaSiguiente}}
                {{^hayPaginaSiguiente}}
                    <span class="paginacion-deshabilitada">Siguiente</span>
                {{/hayPaginaSiguiente}}
            </nav>
        </div>
    </div>

    <dialog class="moderador-correccion-formulario admin-dialogo" id="admin-dialogo-bloqueo" aria-labelledby="admin-titulo-bloqueo">
        <form method="post" action="{{basePath}}/admin/cambiarBloqueoUsuario?{{queryFiltros}}&amp;pagina={{pagina}}">
            <input type="hidden" name="csrf_token" value="{{csrfToken}}">
            <input type="hidden" name="id">
            <input type="hidden" name="bloquear" value="1">
            <div>
                <h2 id="admin-titulo-bloqueo">Bloquear cuenta</h2>
                <p>Se cerrarán las sesiones activas de <strong data-admin-cuenta></strong>.</p>
            </div>
            <div class="admin-form-campo">
                <label for="admin-motivo">Motivo del bloqueo</label>
                <textarea id="admin-motivo" name="motivo" rows="3" maxlength="250" required autofocus></textarea>
            </div>
            <div class="admin-form-acciones">
                <button class="admin-btn" type="button" data-admin-cancelar>Cancelar</button>
                <button class="admin-btn admin-boton-bloqueo" type="submit">Bloquear cuenta</button>
            </div>
        </form>
    </dialog>
    <script src="{{basePath}}/public/js/admin-bloqueo.js" defer></script>
    <script src="{{basePath}}/public/js/admin-usuarios-ajax.js" defer></script>
</main>
