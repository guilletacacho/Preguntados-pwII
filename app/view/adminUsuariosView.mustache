<main class="moderador-shell">
    <nav class="home-sidenav" aria-label="Secciones del sitio">
        <div class="home-side-menu is-expanded">
            <button type="button" class="home-side-toggle" aria-label="Abrir o cerrar navegación" aria-expanded="true" aria-controls="admin-usuarios-side-links"><span aria-hidden="true">☰</span><span class="side-label">Secciones</span></button>
            <div class="home-side-links" id="admin-usuarios-side-links">
                <a href="{{basePath}}/home/show" aria-label="Inicio"><span aria-hidden="true">⌂</span><span class="side-label">Inicio</span></a>
                <a href="{{basePath}}/partida/iniciar" aria-label="Jugar"><span aria-hidden="true">▷</span><span class="side-label">Jugar</span></a>
                <a href="{{basePath}}/ranking" aria-label="Rankings"><span aria-hidden="true">☆</span><span class="side-label">Rankings</span></a>
                <a href="{{basePath}}/admin" aria-label="Panel administrable"><span aria-hidden="true">⚙</span><span class="side-label">Panel administrable</span></a>
                <a href="{{basePath}}/admin/usuarios" aria-label="Usuarios" aria-current="page"><span aria-hidden="true">☺</span><span class="side-label">Usuarios</span></a>
            </div>
        </div>
    </nav>
    <div class="admin-wrap">
        {{> adminEncabezado}}

        <form class="moderador-filtros admin-filtros-usuarios" method="get" action="{{basePath}}/admin/usuarios" role="search" aria-label="Filtros de usuarios">
            <label class="admin-filtro-busqueda">
                Buscar usuarios
                <input type="search" name="busqueda" value="{{filtros.busqueda}}" placeholder="Usuario, nombre o correo" maxlength="100">
            </label>
            <label>
                Rol
                <select name="rol">
                    {{#roles}}
                        <option value="{{value}}" {{#seleccionado}}selected{{/seleccionado}}>{{label}}</option>
                    {{/roles}}
                </select>
            </label>
            <label>
                Estado de la cuenta
                <select name="estado">
                    {{#estados}}
                        <option value="{{value}}" {{#seleccionado}}selected{{/seleccionado}}>{{label}}</option>
                    {{/estados}}
                </select>
            </label>
            <label>
                Alta desde
                <input type="date" name="desde" value="{{filtros.desde}}">
            </label>
            <label>
                Alta hasta
                <input type="date" name="hasta" value="{{filtros.hasta}}">
            </label>
            <label>
                Puntos mínimos
                <input type="number" name="puntosMinimos" value="{{filtros.puntosMinimos}}" min="0" step="1" placeholder="Sin mínimo">
            </label>
            <label>
                Ordenar por
                <select name="orden">
                    {{#ordenes}}
                        <option value="{{value}}" {{#seleccionado}}selected{{/seleccionado}}>{{label}}</option>
                    {{/ordenes}}
                </select>
            </label>
            <div class="admin-filtros-acciones">
                <a class="moderador-boton moderador-boton-cancelar" href="{{basePath}}/admin/usuarios">Limpiar</a>
                <button class="moderador-boton" type="submit">Filtrar</button>
            </div>
        </form>
        {{#errorFechas}}
            <p class="moderador-mensaje moderador-mensaje-error" role="alert">La fecha desde debe ser anterior o igual a la fecha hasta.</p>
        {{/errorFechas}}

        <div class="moderador-tabla-contenedor">
            <table class="moderador-tabla-preguntas admin-tabla-usuarios">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Nombre y correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Puntos</th>
                        <th>Fecha de alta</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {{#usuarios}}
                        <tr>
                            <td><strong>{{usuario}}</strong></td>
                            <td>{{nombre}}<br><span class="moderador-item-meta">{{email}}</span></td>
                            <td>
                                <span class="moderador-badge {{#esAdmin}}moderador-badge-alerta{{/esAdmin}} {{#esModerador}}moderador-badge-verde{{/esModerador}}">{{rol}}</span>
                            </td>
                            <td>
                                {{#verificado}}Verificado{{/verificado}}{{^verificado}}Sin verificar{{/verificado}}
                                {{#bloqueado}}<br><span class="admin-estado-bloqueado">Bloqueado</span>{{/bloqueado}}
                            </td>
                            <td>{{puntos}}</td>
                            <td>{{#fechaAlta}}{{fechaAlta}}{{/fechaAlta}}{{^fechaAlta}}<span class="moderador-item-meta">Sin registro</span>{{/fechaAlta}}</td>
                            <td>
                                <div class="admin-usuario-acciones">
                                    <a class="moderador-boton moderador-boton-corregir" href="{{basePath}}/admin/editarUsuario?id={{id}}" aria-label="Editar a {{usuario}}">Editar</a>
                                    {{^esAdmin}}
                                        <form method="post" action="{{basePath}}/admin/cambiarBloqueoUsuario?{{queryFiltros}}&amp;pagina={{pagina}}" {{^bloqueado}}onsubmit="return confirm('¿Bloquear esta cuenta y cerrar sus sesiones?');"{{/bloqueado}}>
                                            <input type="hidden" name="id" value="{{id}}">
                                            <input type="hidden" name="csrf_token" value="{{csrfToken}}">
                                            {{^bloqueado}}
                                                <button class="moderador-boton admin-boton-bloqueo" type="submit" name="bloquear" value="1" aria-label="Bloquear a {{usuario}}">Bloquear</button>
                                            {{/bloqueado}}
                                            {{#bloqueado}}
                                                <button class="moderador-boton admin-boton-bloqueo" type="submit" name="bloquear" value="0" aria-label="Desbloquear a {{usuario}}">Desbloquear</button>
                                            {{/bloqueado}}
                                        </form>
                                        <form method="post" action="{{basePath}}/admin/bajaUsuario?{{queryFiltros}}&amp;pagina={{pagina}}" onsubmit="return confirm('¿Eliminar esta cuenta de forma permanente?');">
                                            <input type="hidden" name="id" value="{{id}}">
                                            <input type="hidden" name="csrf_token" value="{{csrfToken}}">
                                            <button class="moderador-boton moderador-boton-descartar" type="submit" aria-label="Eliminar a {{usuario}}">Eliminar</button>
                                        </form>
                                    {{/esAdmin}}
                                </div>
                            </td>
                        </tr>
                    {{/usuarios}}
                    {{^usuarios}}
                        <tr><td colspan="7" class="moderador-vacio">No hay usuarios con esos filtros.</td></tr>
                    {{/usuarios}}
                </tbody>
            </table>
        </div>

        <div class="moderador-paginacion">
            <span>Página {{pagina}} de {{paginas}} · {{totalUsuarios}} usuarios</span>
            <nav aria-label="Páginas de usuarios">
                {{#hayPaginaAnterior}}
                    <a href="{{basePath}}/admin/usuarios?{{queryFiltros}}&amp;pagina={{paginaAnterior}}">Anterior</a>
                {{/hayPaginaAnterior}}
                {{^hayPaginaAnterior}}
                    <span class="paginacion-deshabilitada">Anterior</span>
                {{/hayPaginaAnterior}}
                {{#hayPaginaSiguiente}}
                    <a href="{{basePath}}/admin/usuarios?{{queryFiltros}}&amp;pagina={{paginaSiguiente}}">Siguiente</a>
                {{/hayPaginaSiguiente}}
                {{^hayPaginaSiguiente}}
                    <span class="paginacion-deshabilitada">Siguiente</span>
                {{/hayPaginaSiguiente}}
            </nav>
        </div>
    </div>
</main>
