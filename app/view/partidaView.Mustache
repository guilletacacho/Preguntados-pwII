<main class="partida-shell">
    <section class="partida-contenido" aria-label="Pregunta de {{categoria}}">
        <header class="partida-header">
            <div class="partida-categoria">
                <img src="{{basePath}}/public/img/personajes/{{categoriaSlug}}.svg" alt="" class="partida-categoria-icono">
                <strong>{{categoria}}</strong>
                <span>Pregunta {{preguntaNumero}}</span>
            </div>
            <div class="partida-puntos">
                <span>Puntos</span>
                <strong>{{puntos}}</strong>
            </div>
        </header>

        <div class="partida-meta" aria-label="Nivel">
            <span class="partida-chip">Dificultad: {{dificultad}}</span>
            <span class="partida-chip">Tu nivel: {{nivelJugador}}</span>
        </div>

        <div class="partida-progreso"{{^resultadoMostrado}} data-restante="{{tiempoRestante}}" data-limite="{{tiempoLimite}}"{{/resultadoMostrado}} aria-hidden="true">
            <span></span>
        </div>
        {{^resultadoMostrado}}
            <p class="partida-tiempo">Tiempo: <strong id="partida-segundos">{{tiempoRestante}}</strong> s</p>
            <form id="partida-tiempo-form" method="post" action="{{basePath}}/partida/tiempoAgotado" hidden></form>
        {{/resultadoMostrado}}

        <div class="partida-pregunta">
            <img src="{{basePath}}/public/img/personajes/{{categoriaSlug}}.svg" alt="" class="partida-pregunta-icono">
            <h1>{{pregunta}}</h1>
        </div>

        <div class="partida-respuestas">
            {{#resultadoMostrado}}
                {{#respuestas}}
                    <div class="partida-respuesta{{#correcta}} es-correcta{{/correcta}}{{#incorrecta}} es-incorrecta{{/incorrecta}}">
                        <span class="partida-opcion">{{letra}}</span>
                        <strong>{{texto}}</strong>
                    </div>
                {{/respuestas}}
            {{/resultadoMostrado}}

            {{^resultadoMostrado}}
                <form method="post" action="{{basePath}}/partida/responderPregunta" id="partida-respuesta-form">
                    {{#respuestas}}
                        <button type="submit" name="opcion" value="{{token}}" class="partida-respuesta partida-respuesta-boton">
                            <span class="partida-opcion">{{letra}}</span>
                            <strong>{{texto}}</strong>
                        </button>
                    {{/respuestas}}
                </form>
            {{/resultadoMostrado}}
        </div>

        {{^resultadoMostrado}}
            <p class="partida-ayuda">Elegí una respuesta antes de que se acabe el tiempo.</p>

            {{#mensajeReporte}}
                <p class="partida-reporte-mensaje partida-reporte-mensaje-{{tipo}}" role="status">{{texto}}</p>
            {{/mensajeReporte}}

            <details class="partida-reportar">
                <summary>Reportar pregunta</summary>
                <form method="post" action="{{basePath}}/reportarPregunta/crear" class="partida-reportar-form">
                    <input type="hidden" name="question_id" value="{{questionId}}">
                    <input type="hidden" name="csrf_token" value="{{csrfReportarPregunta}}">
                    <label for="reporte-motivo">Motivo</label>
                    <select id="reporte-motivo" name="reason" required>
                        <option value="">Seleccioná un motivo</option>
                        <option value="RESPUESTA_INCORRECTA">La respuesta correcta parece incorrecta</option>
                        <option value="AMBIGUA">La pregunta es ambigua</option>
                        <option value="ERROR_TEXTO">Hay un error de texto</option>
                        <option value="OTRO">Otro problema</option>
                    </select>
                    <label for="reporte-detalle">Detalle (opcional)</label>
                    <textarea id="reporte-detalle" name="detail" maxlength="500" rows="3"></textarea>
                    <button type="submit" class="partida-reportar-enviar">Enviar reporte</button>
                </form>
            </details>
        {{/resultadoMostrado}}

        {{#resultadoMostrado}}
            {{#esCorrecta}}
                <div class="partida-resultado partida-resultado-correcto">
                    <span>¡Respuesta correcta! +{{puntosGanados}} puntos</span>
                    {{#volverRuleta}}
                        <a href="{{basePath}}/partida/continuar" class="partida-siguiente">Volver a la ruleta</a>
                    {{/volverRuleta}}
                </div>
            {{/esCorrecta}}

            {{^esCorrecta}}
                <div class="partida-resultado partida-resultado-incorrecto">
                    <div>
                        <span>{{#tiempoAgotado}}¡Se acabó el tiempo!{{/tiempoAgotado}}{{^tiempoAgotado}}Respuesta incorrecta{{/tiempoAgotado}}</span>
                        <p class="partida-ayuda">La respuesta correcta está marcada en verde.</p>
                    </div>
                    <div class="partida-acciones">
                        <a href="{{basePath}}/partida/salir" class="partida-boton-secundario">Volver al lobby</a>
                        <a href="{{basePath}}/partida/iniciar" class="partida-boton-principal">Jugar de nuevo</a>
                    </div>
                </div>
            {{/esCorrecta}}
        {{/resultadoMostrado}}
    </section>
</main>
<script src="{{basePath}}/public/js/partida-navegacion.js" defer></script>
{{^resultadoMostrado}}
<script src="{{basePath}}/public/js/partida-temporizador.js" defer></script>
{{/resultadoMostrado}}
