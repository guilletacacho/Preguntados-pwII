<div class="w3-content" style="max-width:900px">
    <div class="w3-panel card-contenido w3-padding-24 w3-margin-top w3-card">

        <h2>{{nombre}}</h2>
        <p>{{descripcion}}</p>
        <p><b>📅 Fecha:</b> {{fecha_evento_formateada}} hs</p>
        <p><b>🏟️ Estadio:</b> {{estadio}}</p>

        <hr>

        {{#logueado}}
            <p class="w3-large">Hola, <b>{{usuario}}</b> 👋</p>
            <a href="/Preguntados/lugares" class="w3-button btn-cancha w3-round w3-padding-16 w3-large">Ver lugares disponibles</a>
            <a href="/Preguntados/login/logout" class="w3-button w3-red w3-round w3-margin-left">Cerrar sesión</a>
        {{/logueado}}
        {{^logueado}}
            <h3>Ingresá para reservar tu entrada</h3>

            {{#error}}
                <div class="w3-panel w3-pale-red w3-border">
                    <p>{{error}}</p>
                </div>
            {{/error}}

            <form method="post" action="/Preguntados/login/login">
                <div class="w3-row-padding">
                    <div class="w3-half">
                        <label><b>Usuario</b></label>
                        <input class="w3-input w3-border" type="text" name="usuario" required>
                    </div>
                    <div class="w3-half">
                        <label><b>Contraseña</b></label>
                        <input class="w3-input w3-border" type="password" name="password" required>
                    </div>
                </div>
                <button type="submit" class="w3-button btn-cancha w3-round w3-margin-top w3-padding-16">Ingresar</button>
            </form>
        {{/logueado}}

    </div>
</div>
