<header class="admin-hero">
    <div>
        <span class="admin-eyebrow">Panel administrable</span>
        {{#esResumen}}
            <h1>Resumen del sitio</h1>
            <p>Actividad y estadísticas.</p>
        {{/esResumen}}
        {{#esUsuarios}}
            <h1>Usuarios</h1>
            <p>Gestión de cuentas.</p>
        {{/esUsuarios}}
        {{#esHistorial}}
            <h1>Historial</h1>
            <p>Acciones sobre cuentas.</p>
        {{/esHistorial}}
    </div>
    <a class="admin-btn admin-btn-primary" href="{{basePath}}/admin/altaUsuario">+ Nuevo usuario</a>
</header>

<nav class="admin-tabs" aria-label="Secciones del panel">
    <a class="admin-tab{{#esResumen}} is-active{{/esResumen}}" href="{{basePath}}/admin"{{#esResumen}} aria-current="page"{{/esResumen}}>Resumen</a>
    <a class="admin-tab{{#esUsuarios}} is-active{{/esUsuarios}}" href="{{basePath}}/admin/usuarios"{{#esUsuarios}} aria-current="page"{{/esUsuarios}}>Usuarios <span class="admin-badge">{{#totalUsuariosHistorico}}{{totalUsuariosHistorico}}{{/totalUsuariosHistorico}}{{^totalUsuariosHistorico}}{{totalUsuarios}}{{/totalUsuariosHistorico}}</span></a>
    <a class="admin-tab{{#esHistorial}} is-active{{/esHistorial}}" href="{{basePath}}/admin/historial"{{#esHistorial}} aria-current="page"{{/esHistorial}}>Historial</a>
    {{#esResumen}}
        <button class="admin-btn admin-btn-primary admin-tab-imprimir" type="button" data-imprimir-admin>Imprimir reportes</button>
    {{/esResumen}}
</nav>

{{#mensaje}}
    <p class="moderador-mensaje moderador-mensaje-{{tipo}}" role="status">{{texto}}</p>
{{/mensaje}}
