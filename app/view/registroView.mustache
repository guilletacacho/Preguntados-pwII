<main class="container login-shell register-shell d-flex justify-content-center">
    <section class="register-page">
        <div class="register-head">
            <div>
                <h1>Creá tu cuenta</h1>
                <p>Completá tus datos para empezar a jugar.</p>
            </div>
            <ul class="personajes" aria-hidden="true">
                <li><img src="{{basePath}}/public/img/personajes/arte.svg" alt="" width="204" height="206"></li>
                <li><img src="{{basePath}}/public/img/personajes/historia.svg" alt="" width="204" height="206"></li>
            </ul>
        </div>
        {{#error}}
            <div class="alert alert-danger" role="alert">{{error}}</div>
        {{/error}}
        <form id="registro-form" method="post" action="{{basePath}}/registro/registrar" enctype="multipart/form-data">
            <div class="register-grid">
                <div class="register-col">
                    <h2>Sobre vos</h2>
                    <div class="foto-perfil">
                        <button type="button" class="foto-perfil-icono" id="foto-preview" aria-label="Editar foto de perfil" disabled>
                            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
                            <img alt="" hidden>
                        </button>
                        <div class="foto-perfil-datos">
                            <p class="form-label">Foto de perfil</p>
                            <small>JPG o PNG, hasta 5 MB.</small>
                            <div class="foto-perfil-elegir">
                                <input class="visually-hidden" type="file" id="imagen_url" name="imagen_url" accept="image/jpeg,image/png">
                                <label for="imagen_url" class="foto-perfil-boton">Elegir foto</label>
                                <span id="imagen_url-nombre" class="foto-perfil-nombre">Ninguna elegida</span>
                            </div>
                            <p id="imagen_url-aviso" class="foto-perfil-aviso" aria-live="polite"></p>
                        </div>
                    </div>
                    <div>
                        <label for="nombre" class="form-label">Nombre completo</label>
                        <input class="form-control {{#errores.nombre}}is-invalid{{/errores.nombre}}" id="nombre" aria-describedby="nombre-error" name="nombre" value="{{nombre}}" type="text" placeholder="Sofía Martínez" autocomplete="name" required>
                        <div id="nombre-error" class="invalid-feedback" aria-live="polite">{{errores.nombre}}</div>
                    </div>
                    <div class="register-row">
                        <div>
                            <label for="anioNacimiento" class="form-label">Año de nacimiento</label>
                            <input class="form-control {{#errores.anioNacimiento}}is-invalid{{/errores.anioNacimiento}}" id="anioNacimiento" aria-describedby="anioNacimiento-error" name="anioNacimiento" value="{{anioNacimiento}}" type="number" min="1900" max="{{anioActual}}" placeholder="2002" required>
                            <div id="anioNacimiento-error" class="invalid-feedback" aria-live="polite">{{errores.anioNacimiento}}</div>
                        </div>
                        <div>
                            <label for="sexo" class="form-label">Sexo</label>
                            <select class="form-select {{#errores.sexo}}is-invalid{{/errores.sexo}}" id="sexo" aria-describedby="sexo-error" name="sexo" required>
                                <option value="" {{^sexo}}selected{{/sexo}} disabled>Elegí una opción</option>
                                <option value="Femenino" {{#sexoFemenino}}selected{{/sexoFemenino}}>Femenino</option>
                                <option value="Masculino" {{#sexoMasculino}}selected{{/sexoMasculino}}>Masculino</option>
                                <option value="Otro" {{#sexoOtro}}selected{{/sexoOtro}}>Otro</option>
                            </select>
                            <div id="sexo-error" class="invalid-feedback" aria-live="polite">{{errores.sexo}}</div>
                        </div>
                    </div>

                    <h2 class="register-subtitulo">Tu cuenta</h2>
                    <div>
                        <label for="usuario" class="form-label">Nombre de usuario</label>
                        <input class="form-control {{#errores.usuario}}is-invalid{{/errores.usuario}}" id="usuario" aria-describedby="usuario-error" name="usuario" value="{{usuario}}" type="text" placeholder="triviamaster_99" autocomplete="username" required>
                        <div id="usuario-error" class="invalid-feedback" aria-live="polite">{{errores.usuario}}</div>
                    </div>
                    <div class="register-row">
                        <div>
                            <label for="contrasena" class="form-label">Contraseña</label>
                            <div class="password-field">
                                <input class="form-control {{#errores.contrasena}}is-invalid{{/errores.contrasena}}" id="contrasena" aria-describedby="contrasena-error" name="contrasena" type="password" placeholder="Mínimo 8 caracteres" minlength="8" autocomplete="new-password" required>
                                <button class="btn password-toggle" type="button" data-password-toggle="contrasena" aria-controls="contrasena" aria-label="Mostrar contrase&#241;a" aria-pressed="false" hidden>
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/><path class="eye-slash" d="M3 3l18 18"/></svg>
                                </button>
                            </div>
                            <div id="contrasena-error" class="invalid-feedback" aria-live="polite">{{errores.contrasena}}</div>
                        </div>
                        <div>
                            <label for="repetirContrasena" class="form-label">Repetir contraseña</label>
                            <div class="password-field">
                                <input class="form-control {{#errores.repetirContrasena}}is-invalid{{/errores.repetirContrasena}}" id="repetirContrasena" aria-describedby="repetirContrasena-error" name="repetirContrasena" type="password" placeholder="La misma otra vez" minlength="8" autocomplete="new-password" required>
                                <button class="btn password-toggle" type="button" data-password-toggle="repetirContrasena" aria-controls="repetirContrasena" aria-label="Mostrar contrase&#241;a" aria-pressed="false" hidden>
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/><path class="eye-slash" d="M3 3l18 18"/></svg>
                                </button>
                            </div>
                            <div id="repetirContrasena-error" class="invalid-feedback" aria-live="polite">{{errores.repetirContrasena}}</div>
                        </div>
                    </div>
                </div>

                <div class="register-col">
                    <h2>Dónde estás</h2>
                    <div id="map"></div>
                    <div>
                        <label for="ubicacion" class="form-label">País y provincia</label>
                        <input class="form-control {{#errores.ubicacion}}is-invalid{{/errores.ubicacion}}" id="ubicacion" aria-describedby="ubicacion-error pais-ayuda" name="ubicacion" value="{{ubicacion}}" type="text" placeholder="Se detectará al dar permiso de ubicación" readonly required>
                        <div id="ubicacion-error" class="invalid-feedback" aria-live="polite">{{errores.ubicacion}}</div>
                        <p id="pais-ayuda" class="helper mt-2 mb-0">Se consulta Nominatim de OpenStreetMap para mostrar tu país y provincia. Al registrarte se guardan esos nombres, no tus coordenadas.</p>
                        <input type="hidden" name="latitude" id="latitude">
                        <input type="hidden" name="longitude" id="longitude">
                    </div>
                    <div class="mb-3">
                            <label for="email" class="form-label">Correo electrónico</label>
                            <input class="form-control {{#errores.email}}is-invalid{{/errores.email}}" id="email" aria-describedby="email-error" name="email" value="{{email}}" type="email" placeholder="tu@correo.com" autocomplete="email" required>
                            <div id="email-error" class="invalid-feedback" aria-live="polite">{{errores.email}}</div>                        </div>
                        <div class="mb-3">
                    <div class="register-submit">
                        <button class="btn submit-btn w-100" type="submit">Crear cuenta</button>
                        <p class="helper">¿Ya tenés cuenta? <a class="register-link" href="{{basePath}}/login">Iniciá sesión</a></p>
                    </div>
                </div>
            </div>
        </form>
    </section>
</main>

<dialog class="editor-foto" id="editor-foto" aria-labelledby="editor-foto-titulo">
    <div class="editor-foto-head">
        <h2 id="editor-foto-titulo">Editar imagen</h2>
        <button type="button" class="editor-foto-cerrar" data-editor="cancelar" aria-label="Cerrar">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
    </div>
    <div class="editor-foto-area" id="editor-foto-area" tabindex="0" aria-label="Vista previa. Arrastrá o usá las flechas para mover la imagen.">
        <img id="editor-foto-img" alt="" draggable="false">
        <div class="editor-foto-mascara" aria-hidden="true"></div>
    </div>
    <div class="editor-foto-zoom">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2"/></svg>
        <input type="range" id="editor-foto-zoom" min="1" max="3" step="0.01" value="1" aria-label="Zoom">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
    </div>
    <div class="editor-foto-acciones">
        <button type="button" class="editor-foto-reiniciar" data-editor="reiniciar">Reiniciar</button>
        <div>
            <button type="button" class="btn editor-foto-cancelar" data-editor="cancelar">Cancelar</button>
            <button type="button" class="btn submit-btn" data-editor="aplicar">Aplicar</button>
        </div>
    </div>
</dialog>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="{{basePath}}/public/js/registro.js" defer></script>
<script src="{{basePath}}/public/js/foto-perfil.js" defer></script>
