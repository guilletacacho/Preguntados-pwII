<link rel="stylesheet" href="{{basePath}}/public/css/sugerencias.css?v=5">
<main class="home-shell sugerencias-shell" id="sugerencias">
    {{> navegacionLateral}}

    <div class="home-content">
        <header class="home-welcome">
            <span class="eyebrow">TU IDEA PUEDE SER LA PRÓXIMA PREGUNTA</span>
            <h1>Sugerir una pregunta</h1>
            <p>Compartí una pregunta interesante. El equipo la revisará antes de incorporarla al juego.</p>
        </header>

        {{#haySugerenciaError}}
            <p class="sugerencias-error" role="alert">{{sugerenciaError}}</p>
        {{/haySugerenciaError}}

        <div class="sugerencias-layout">
            <section class="home-card sugerencias-form-card" aria-labelledby="sugerencias-form-title">
                <h2 id="sugerencias-form-title">¿Qué pregunta te gustaría sugerir?</h2>
                <p>Elegí una categoría y escribí el enunciado. Las respuestas serán preparadas por el moderador.</p>
                <button type="button" class="submit-btn sugerencias-cta" aria-expanded="{{#haySugerenciaError}}true{{/haySugerenciaError}}{{^haySugerenciaError}}false{{/haySugerenciaError}}" aria-controls="sugerencias-form-wrap" {{#haySugerenciaError}}disabled{{/haySugerenciaError}}>Proponer una pregunta</button>

                <div class="sugerencias-form-wrap{{#haySugerenciaError}} is-open{{/haySugerenciaError}}" id="sugerencias-form-wrap" aria-hidden="{{#haySugerenciaError}}false{{/haySugerenciaError}}{{^haySugerenciaError}}true{{/haySugerenciaError}}" {{^haySugerenciaError}}inert{{/haySugerenciaError}}>
                    <form class="sugerencias-form" action="{{basePath}}/home/enviarSugerencia" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" value="{{csrfToken}}">
                    <label for="categoria-sugerida">Categoría</label>
                    <select id="categoria-sugerida" name="category" required>
                        <option value="" selected disabled>Seleccioná una categoría</option>
                        {{#categorias}}
                        <option value="{{id}}" data-color="{{color}}">{{name}}</option>
                        {{/categorias}}
                    </select>

                    <label for="pregunta-sugerida">Pregunta sugerida</label>
                    <textarea id="pregunta-sugerida" name="question" rows="5" maxlength="500" required placeholder="Escribí acá el enunciado de tu pregunta"></textarea>

                    <label for="imagen-sugerida">Imagen (opcional)</label>
                    <input id="imagen-sugerida" name="image" type="file" accept="image/jpeg,image/png" aria-describedby="imagen-sugerida-ayuda">
                    <small id="imagen-sugerida-ayuda" class="sugerencias-imagen-ayuda">JPG o PNG, hasta 5 MB.</small>
                    <div class="sugerencias-imagen-preview-wrap" id="imagen-sugerida-preview-wrap" hidden>
                        <img id="imagen-sugerida-preview" class="sugerencias-imagen-preview" alt="Vista previa de la imagen seleccionada">
                    </div>
                    <p class="sugerencias-imagen-nombre" id="imagen-sugerida-nombre" aria-live="polite">Ninguna imagen seleccionada.</p>

                    <div class="sugerencias-form-actions">
                        <button type="submit" class="submit-btn sugerencias-enviar">Enviar pregunta</button>
                        <a class="sugerencias-cancelar" href="{{basePath}}/home/show">Cancelar</a>
                    </div>
                </form>
                </div>
            </section>

            <aside class="sugerencias-aprobadas" aria-labelledby="sugerencias-aprobadas-title">
                <h2 id="sugerencias-aprobadas-title">Últimas preguntas sugeridas aprobadas</h2>
                <div class="sugerencias-aprobadas-scroll" tabindex="0" aria-label="Lista desplazable de preguntas aprobadas">
                    {{#preguntasAprobadas}}
                    <article class="home-card sugerencia-aprobada" data-categoria="{{categoria}}">
                        <span class="eyebrow">PREGUNTA</span>
                        <h3>{{pregunta}}</h3>
                        <p class="sugerencia-categoria" data-categoria="{{categoria}}">Categoría: <strong>{{categoria}}</strong></p>
                        <p>Sugerida por: <strong>{{usuario}}</strong></p>
                    </article>
                    {{/preguntasAprobadas}}
                    {{^preguntasAprobadas}}
                    <p class="sugerencias-sin-aprobadas">Todavía no hay preguntas sugeridas aprobadas.</p>
                    {{/preguntasAprobadas}}
                </div>
            </aside>
        </div>
    </div>
</main>

<script src="{{basePath}}/public/js/sugerencias.js?v=3" defer></script>
