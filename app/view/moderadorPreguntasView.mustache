<main class="moderador-shell">
    <nav class="home-sidenav" aria-label="Secciones del sitio">
        <div class="home-side-menu">
            <button type="button" class="home-side-toggle" aria-label="Abrir o cerrar navegación" aria-expanded="false" aria-controls="moderador-preguntas-side-links"><span aria-hidden="true">☰</span><span class="side-label">Secciones</span></button>
            <div class="home-side-links" id="moderador-preguntas-side-links">
                <a href="{{basePath}}/home/show" aria-label="Inicio"><span aria-hidden="true">⌂</span><span class="side-label">Inicio</span></a>
                <a href="{{basePath}}/home/show#jugar" aria-label="Jugar"><span aria-hidden="true">▷</span><span class="side-label">Jugar</span></a>
                <a href="{{basePath}}/ranking" aria-label="Rankings"><span aria-hidden="true">☆</span><span class="side-label">Rankings</span></a>
                <a href="{{basePath}}/home/show#preguntas-frecuentes" aria-label="Preguntas frecuentes"><span aria-hidden="true">?</span><span class="side-label">Preguntas frecuentes</span></a>
                <a href="{{basePath}}/home/show#terminos" aria-label="Términos y condiciones"><span aria-hidden="true">§</span><span class="side-label">Términos y condiciones</span></a>
                <a href="{{basePath}}/moderador" aria-label="Panel moderador" aria-current="page"><span aria-hidden="true"><svg class="side-flag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4m0 1c5-4 9 4 14 0v11c-5 4-9-4-14 0"></path></svg></span><span class="side-label">Panel moderador</span></a>
            </div>
        </div>
    </nav>

    <div class="moderador-content">
        <header class="moderador-header">
            <div>
                <span class="moderador-eyebrow">PANEL MODERADOR</span>
                <h1>Preguntas</h1>
                <p>Alta, baja y modificación de todas las preguntas del juego.</p>
            </div>
            <a class="moderador-nueva-pregunta" href="{{basePath}}/moderador/altaPregunta">+ Nueva pregunta</a>
        </header>

        <nav class="moderador-tabs" aria-label="Secciones del panel">
            <a class="moderador-tab" href="{{basePath}}/moderador">Resumen</a>
            <button class="moderador-tab" type="button">Reportes <span class="moderador-badge moderador-badge-alerta">7</span></button>
            <button class="moderador-tab" type="button">Sugeridas <span class="moderador-badge">3</span></button>
            <a class="moderador-tab is-active" href="{{basePath}}/moderador/preguntas" aria-current="page">Preguntas</a>
        </nav>

        <section class="moderador-preguntas" aria-label="Administrar preguntas">
            <form class="moderador-filtros" role="search">
                <label class="visually-hidden" for="moderador-busqueda">Buscar pregunta por texto o identificador</label>
                <input id="moderador-busqueda" type="search" placeholder="Buscar por texto o #id">
                <label class="visually-hidden" for="moderador-categoria">Filtrar por categoría</label>
                <select id="moderador-categoria">
                    <option>Todas las categorías</option>
                    <option>Geografía</option>
                    <option>Deporte</option>
                    <option>Ciencia</option>
                    <option>Cine y TV</option>
                    <option>Arte</option>
                    <option>Historia</option>
                </select>
                <label class="visually-hidden" for="moderador-dificultad">Filtrar por dificultad</label>
                <select id="moderador-dificultad">
                    <option>Toda dificultad</option>
                    <option>Fácil</option>
                    <option>Media</option>
                    <option>Difícil</option>
                </select>
                <label class="visually-hidden" for="moderador-estado">Filtrar por estado</label>
                <select id="moderador-estado">
                    <option>Activas</option>
                    <option>Todas</option>
                    <option>Dadas de baja</option>
                </select>
            </form>

            <div class="moderador-tabla-contenedor">
                <table class="moderador-tabla-preguntas">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Pregunta</th>
                            <th scope="col">Categoría</th>
                            <th scope="col">Dificultad</th>
                            <th scope="col">Entregas</th>
                            <th scope="col">Acierto</th>
                            <th scope="col">Reportes</th>
                            <th scope="col"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>148</td>
                            <td>¿Cuál es la capital de Australia?</td>
                            <td><span class="moderador-categoria categoria-geografia">Geografía</span></td>
                            <td><span class="moderador-dificultad dificultad-media" aria-label="Dificultad media"><i></i><i></i><i></i></span></td>
                            <td>212</td>
                            <td>41%</td>
                            <td><span class="moderador-reporte-cantidad">⚑ 3</span></td>
                            <td class="moderador-acciones"><button type="button" class="moderador-accion-editar">Editar</button><button type="button" class="moderador-accion-baja">Baja</button></td>
                        </tr>
                        <tr class="pregunta-inactiva">
                            <td>77</td>
                            <td>¿Quién es el actual presidente de Francia?</td>
                            <td><span class="moderador-categoria categoria-historia">Historia</span></td>
                            <td><span class="moderador-dificultad dificultad-media" aria-label="Dificultad media"><i></i><i></i><i></i></span></td>
                            <td>150</td>
                            <td>62%</td>
                            <td><span class="moderador-estado-baja">DADA DE BAJA</span></td>
                            <td class="moderador-acciones"><button type="button" class="moderador-accion-reactivar">Reactivar</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <footer class="moderador-paginacion">
                <span>Mostrando 1–10 de 316</span>
                <nav aria-label="Paginación de preguntas">
                    <button type="button">← Anterior</button>
                    <button type="button">Siguiente →</button>
                </nav>
            </footer>
        </section>
    </div>
</main>
<script>
    document.querySelector('.moderador-shell .home-side-toggle').addEventListener('click', function () {
        const expanded = this.getAttribute('aria-expanded') !== 'true';
        this.setAttribute('aria-expanded', String(expanded));
        this.parentElement.classList.toggle('is-expanded', expanded);
    });
    document.querySelector('.moderador-shell .home-side-menu').addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            this.classList.remove('is-expanded');
            this.querySelector('button').setAttribute('aria-expanded', 'false');
            this.querySelector('button').focus();
        }
    });
</script>
