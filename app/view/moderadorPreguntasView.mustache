<main class="moderador-shell">
    {{> navegacionLateral}}

    <div class="moderador-content">
        <header class="moderador-header">
            <div>
                <span class="moderador-eyebrow">Preguntados · Moderación</span>
                <h1>Preguntas</h1>
                <p>Alta, baja y modificación de todas las preguntas del juego.</p>
            </div>
            <a class="moderador-nueva-pregunta" href="{{basePath}}/moderador/altaPregunta">+ Nueva pregunta</a>
        </header>

        {{> moderadorNavegacion}}

        {{#mensaje}}
            <p class="moderador-mensaje moderador-mensaje-{{tipo}}" role="status">{{texto}}</p>
        {{/mensaje}}

        {{#hayMensaje}}
        <p class="moderador-mensaje moderador-mensaje-{{mensaje.tipo}}" role="status">{{mensaje.texto}}</p>
        {{/hayMensaje}}

        <section class="moderador-preguntas" aria-label="Administrar preguntas">
            <form class="moderador-filtros" method="get" action="{{basePath}}/moderador/preguntas" role="search">
                <label class="visually-hidden" for="moderador-busqueda">Buscar pregunta por texto</label>
                <input id="moderador-busqueda" type="search" placeholder="Buscar por texto" name="texto" value="{{textoBusqueda}}">
                <label class="visually-hidden" for="moderador-categoria">Filtrar por categoría</label>
                <select id="moderador-categoria" name="categoria_id">
                    <option value="" {{#todasCategoriasSeleccionada}}selected{{/todasCategoriasSeleccionada}}>Todas las categorías</option>
                    {{#categorias}}
                    <option value="{{id}}" {{#seleccionada}}selected{{/seleccionada}}>{{name}}</option>
                    {{/categorias}}
                </select>
                <label class="visually-hidden" for="moderador-dificultad">Filtrar por dificultad</label>
                <select id="moderador-dificultad" name="dificultad">
                    <option value="" {{#todaDificultadSeleccionada}}selected{{/todaDificultadSeleccionada}}>Toda dificultad</option>
                    <option value="1" {{#dificultadFacilSeleccionada}}selected{{/dificultadFacilSeleccionada}}>Fácil</option>
                    <option value="2" {{#dificultadMediaSeleccionada}}selected{{/dificultadMediaSeleccionada}}>Media</option>
                    <option value="3" {{#dificultadDificilSeleccionada}}selected{{/dificultadDificilSeleccionada}}>Difícil</option>
                </select>
                <label class="visually-hidden" for="moderador-estado">Filtrar por estado</label>
                <select id="moderador-estado" name="estado">
                    <option value="activa" {{#estadoActivaSeleccionada}}selected{{/estadoActivaSeleccionada}}>Activas</option>
                    <option value="todas" {{#estadoTodasSeleccionada}}selected{{/estadoTodasSeleccionada}}>Todas</option>
                    <option value="inactiva" {{#estadoInactivaSeleccionada}}selected{{/estadoInactivaSeleccionada}}>Dadas de baja</option>
                </select>
            </form>

            <div class="moderador-tabla-contenedor">
                <table class="moderador-tabla-preguntas">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Pregunta</th>
                            <th scope="col">Categoría</th>
                            <th scope="col">Dificultad</th>
                            <th scope="col">Entregas</th>
                            <th scope="col">Acierto</th>
                            <th scope="col">Reportes</th>
                            <th scope="col"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#preguntas}}
                        <tr{{^activa}} class="pregunta-inactiva"{{/activa}}>
                            <td>{{id}}</td>
                            <td>{{question}}</td>
                            <td><span class="moderador-categoria" style="color: {{categoria_color}}">{{categoria}}</span></td>
                            <td><span class="moderador-dificultad" data-dificultad="{{dificultad}}" aria-label="Dificultad nivel {{dificultad}} de 3"><i></i><i></i><i></i></span></td>
                            <td>{{entregas}}</td>
                            <td>{{acierto}}%</td>
                            <td><span class="moderador-reporte-cantidad">⚑ 3</span></td>
                            <td class="moderador-acciones">
                                <div class="moderador-acciones-contenido">
                                    {{#activa}}
                                    <a class="moderador-accion-editar" href="{{basePath}}/moderador/editarPregunta?id={{id}}">Editar</a>
                                    {{! ESTE FORMULARIO ENVIA EL ID DE LA PREGUNTA AL CONTROLLER PARA DARLA DE BAJA. }}
                                    <form method="post" action="{{basePath}}/moderador/desactivarPregunta">
                                        <input type="hidden" name="csrf_token" value="{{csrfToken}}">
                                        <input type="hidden" name="question_id" value="{{id}}">
                                        <button type="submit" class="moderador-accion-baja">Baja</button>
                                    </form>
                                    {{/activa}}
                                    {{^activa}}
                                    <span class="moderador-estado-baja">DADA DE BAJA</span>
                                    <form method="post" action="{{basePath}}/moderador/reactivarPregunta">
                                        <input type="hidden" name="csrf_token" value="{{csrfToken}}">
                                        <input type="hidden" name="question_id" value="{{id}}">
                                        <button type="submit" class="moderador-accion-reactivar">Reactivar</button>
                                    </form>
                                    {{/activa}}
                                </div>
                            </td>
                        </tr>
                        {{/preguntas}}
                        {{^preguntas}}
                        <tr>
                            <td colspan="8">No hay preguntas que coincidan con los filtros seleccionados.</td>
                        </tr>
                        {{/preguntas}}
                    </tbody>
                </table>
            </div>

            <footer class="moderador-paginacion">
                <span>Mostrando {{desde}}–{{hasta}} de {{totalPreguntas}}</span>
                <nav aria-label="Paginación de preguntas">
                    {{#hayPaginaAnterior}}
                    <a href="{{basePath}}/moderador/preguntas?pagina={{paginaAnterior}}{{#queryFiltros}}&amp;{{queryFiltros}}{{/queryFiltros}}">← Anterior</a>
                    {{/hayPaginaAnterior}}
                    {{^hayPaginaAnterior}}
                    <span class="paginacion-deshabilitada" aria-disabled="true">← Anterior</span>
                    {{/hayPaginaAnterior}}
                    {{#hayPaginaSiguiente}}
                    <a href="{{basePath}}/moderador/preguntas?pagina={{paginaSiguiente}}{{#queryFiltros}}&amp;{{queryFiltros}}{{/queryFiltros}}">Siguiente →</a>
                    {{/hayPaginaSiguiente}}
                    {{^hayPaginaSiguiente}}
                    <span class="paginacion-deshabilitada" aria-disabled="true">Siguiente →</span>
                    {{/hayPaginaSiguiente}}
                </nav>
            </footer>
        </section>
    </div>
</main>
<script>
    document.querySelectorAll('.moderador-filtros select').forEach(function (select) {
        select.addEventListener('change', function () {
            this.form.submit();
        });
    });
</script>
