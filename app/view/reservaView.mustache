<div class="w3-content" style="max-width:900px">
    <div class="w3-panel card-contenido w3-padding-24 w3-margin-top w3-card">

        <p><b>Sector:</b> {{sector}} — <b>Precio:</b> ${{precio}}</p>

        <form method="post" action="/Preguntados/reserva/crearReserva">
            <input type="hidden" name="lugar_id" value="{{id}}">

            <div class="w3-row-padding">
                <div class="w3-half">
                    <label><b>Nombre</b></label>
                    <input class="w3-input w3-border" type="text" name="nombre" required>
                </div>
                <div class="w3-half">
                    <label><b>Apellido</b></label>
                    <input class="w3-input w3-border" type="text" name="apellido" required>
                </div>
            </div>
            <div class="w3-row-padding w3-margin-top">
                <div class="w3-third">
                    <label><b>DNI</b></label>
                    <input class="w3-input w3-border" type="text" name="dni" required>
                </div>
                <div class="w3-third">
                    <label><b>Email</b></label>
                    <input class="w3-input w3-border" type="email" name="email" required>
                </div>
                <div class="w3-third">
                    <label><b>Teléfono</b></label>
                    <input class="w3-input w3-border" type="text" name="telefono" required>
                </div>
            </div>

            <button type="submit" class="w3-button btn-cancha w3-round w3-margin-top w3-padding-16">Confirmar reserva</button>
        </form>

        <a href="/Preguntados/lugares" class="w3-button w3-light-grey w3-round w3-margin-top">Volver</a>
    </div>
</div>
