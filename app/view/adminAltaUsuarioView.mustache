<main class="moderador-shell">
    <nav class="home-sidenav" aria-label="Secciones del sitio">
        <div class="home-side-menu is-expanded">
            <button type="button" class="home-side-toggle" aria-label="Abrir o cerrar navegación" aria-expanded="true" aria-controls="admin-alta-side-links"><span aria-hidden="true">☰</span><span class="side-label">Secciones</span></button>
            <div class="home-side-links" id="admin-alta-side-links">
                <a href="{{basePath}}/home/show" aria-label="Inicio"><span aria-hidden="true">⌂</span><span class="side-label">Inicio</span></a>
                <a href="{{basePath}}/partida/iniciar" aria-label="Jugar"><span aria-hidden="true">▷</span><span class="side-label">Jugar</span></a>
                <a href="{{basePath}}/ranking" aria-label="Rankings"><span aria-hidden="true">☆</span><span class="side-label">Rankings</span></a>
                <a href="{{basePath}}/admin" aria-label="Panel administrable"><span aria-hidden="true">⚙</span><span class="side-label">Panel administrable</span></a>
                <a href="{{basePath}}/admin/usuarios" aria-label="Usuarios"><span aria-hidden="true">☺</span><span class="side-label">Usuarios</span></a>
                <a href="{{basePath}}/admin/altaUsuario" aria-label="Nuevo usuario" aria-current="page"><span aria-hidden="true">+</span><span class="side-label">Nuevo usuario</span></a>
            </div>
        </div>
    </nav>
    <div class="moderador-content">
        <header class="moderador-editor-encabezado">
            <a class="moderador-editor-volver" href="{{basePath}}/admin/usuarios">← Volver a usuarios</a>
            <span class="moderador-eyebrow">PANEL ADMINISTRABLE</span>
            <h1>Nuevo usuario</h1>
            <p>Cargá una cuenta manualmente. El alta queda lista para usar en cualquier equipo.</p>
        </header>

        {{#mensaje}}
            <p class="moderador-mensaje moderador-mensaje-{{tipo}}" role="alert">{{texto}}</p>
        {{/mensaje}}
        {{#errores}}
            <p class="moderador-mensaje moderador-mensaje-error" role="alert">{{.}}</p>
        {{/errores}}

        <article class="moderador-correccion-formulario">
            <form method="post" action="{{basePath}}/admin/crearUsuario">
                <input type="hidden" name="csrf_token" value="{{csrfToken}}">

                <label for="nombre">Nombre</label>
                <input id="nombre" name="nombre" type="text" value="{{nombre}}" maxlength="50" required>

                <label for="usuario">Nombre de usuario</label>
                <input id="usuario" name="usuario" type="text" value="{{usuario}}" minlength="3" maxlength="255" required>

                <label for="email">Correo</label>
                <input id="email" name="email" type="email" value="{{email}}" maxlength="255" required>

                <label for="contrasena">Contraseña</label>
                <input id="contrasena" name="contrasena" type="password" minlength="8" autocomplete="new-password" required>
                <span class="moderador-item-meta">Mínimo 8 caracteres.</span>

                <label for="anioNacimiento">Año de nacimiento</label>
                <input id="anioNacimiento" name="anioNacimiento" type="number" value="{{anioNacimiento}}" min="1900" max="{{anioActual}}" required>

                <label for="sexo">Sexo</label>
                <input id="sexo" name="sexo" type="text" value="{{sexo}}" maxlength="30" placeholder="No especificado">

                <label for="provincia">Provincia</label>
                <input id="provincia" name="provincia" type="text" value="{{provincia}}" maxlength="150" required>

                <label for="pais">País</label>
                <input id="pais" name="pais" type="text" value="{{pais}}" maxlength="150" required>

                <label for="rol">Rol</label>
                <select id="rol" name="rol">
                    {{#roles}}
                        <option value="{{value}}" {{#seleccionado}}selected{{/seleccionado}}>{{label}}</option>
                    {{/roles}}
                </select>

                <label class="moderador-correccion-radio admin-check-card" for="verificado">
                    <input id="verificado" name="verificado" type="checkbox" value="1" {{#verificado}}checked{{/verificado}}>
                    <span class="admin-check-copy">
                        <strong>Correo verificado</strong>
                        <small>Puede iniciar sesión en el sitio.</small>
                    </span>
                </label>

                <div class="moderador-acciones">
                    <button class="moderador-boton moderador-boton-resolver" type="submit">Crear usuario</button>
                    <a class="moderador-boton moderador-boton-cancelar" href="{{basePath}}/admin/usuarios">Cancelar</a>
                </div>
            </form>
        </article>
    </div>
</main>
