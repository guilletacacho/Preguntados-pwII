<main class="moderador-shell">
    {{> navegacionLateral}}
    <div class="moderador-content">
        <header class="moderador-header">
            <div>
                <span class="moderador-eyebrow">MODERACIÓN</span>
                <h1>Resumen</h1>
                <p>Lo que necesita tu revisión hoy.</p>
            </div>
            <a class="moderador-nueva-pregunta" href="{{basePath}}/moderador/altaPregunta">+ Nueva pregunta</a>
        </header>

        {{> moderadorNavegacion}}

        <section class="moderador-metricas" aria-label="Resumen de actividad">
            <article class="moderador-metrica">
                <strong class="es-alerta">{{pendientes}}</strong>
                <span>Reportes pendientes</span>
            </article>
            <article class="moderador-metrica">
                <strong>{{sugerenciasPendientes}}</strong>
                <span>Sugerencias pendientes</span>
            </article>
            <article class="moderador-metrica">
                <strong>{{preguntasActivas}}</strong>
                <span>Preguntas activas</span>
            </article>
            <article class="moderador-metrica">
                <strong>{{reportesResueltos}}</strong>
                <span>Reportes resueltos</span>
            </article>
        </section>

        <div class="moderador-contenido">
            <section class="moderador-panel moderador-reportes" aria-labelledby="moderador-reportes-titulo">
                <header class="moderador-panel-header">
                    <h2 id="moderador-reportes-titulo">Últimos reportes</h2>
                    <a class="moderador-boton-secundario" href="{{basePath}}/moderador/reportes">Ver bandeja</a>
                </header>
                <ul class="moderador-lista-reportes">
                    {{#ultimosReportes}}
                    <li class="moderador-reporte">
                        <span class="moderador-reporte-icono" data-categoria="{{categoria}}" aria-hidden="true">!</span>
                        <div class="moderador-reporte-detalle">
                            <strong>«{{pregunta}}»</strong>
                            <small>{{motivoResumen}} · {{fechaFormateada}}</small>
                        </div>
                        <span class="moderador-estado {{claseEstado}}">{{status}}</span>
                    </li>
                    {{/ultimosReportes}}
                    {{^ultimosReportes}}
                    <li class="moderador-reporte">Todavía no hay reportes.</li>
                    {{/ultimosReportes}}
                </ul>
            </section>

            <section class="moderador-panel moderador-motivos" aria-labelledby="moderador-motivos-titulo">
                <h2 id="moderador-motivos-titulo">Motivos más reportados</h2>
                <ul class="moderador-barras">
                    {{#motivosRecientes}}
                    <li><span>{{texto}}</span><span class="moderador-barra" aria-hidden="true"><i style="--barra: {{porcentaje}}%"></i></span><strong>{{cantidad}}</strong></li>
                    {{/motivosRecientes}}
                </ul>
                {{^motivosRecientes}}
                    <p>No hay motivos registrados en este período.</p>
                {{/motivosRecientes}}
                <p class="moderador-periodo">Últimos 30 días.</p>
            </section>
        </div>
    </div>
</main>
