<main class="moderador-shell">
    {{> navegacionLateral}}
    <div class="moderador-content">
        <header class="moderador-editor-encabezado">
            <a class="moderador-editor-volver" href="{{basePath}}/admin/usuarios">← Volver a usuarios</a>
            <span class="moderador-eyebrow">ADMINISTRACIÓN</span>
            <h1>Editar usuario</h1>
            <p>Modificá los datos de <strong>{{usuario}}</strong>. Dejá la contraseña vacía para mantener la actual.</p>
        </header>
        {{> adminNavegacion}}

        {{#mensaje}}
            <p class="moderador-mensaje moderador-mensaje-{{tipo}}" role="alert">{{texto}}</p>
        {{/mensaje}}

        <div class="moderador-correccion-columnas admin-editar-usuario-columnas">
            <article class="moderador-correccion-formulario">
                <form method="post" action="{{basePath}}/admin/actualizarUsuario">
                <input type="hidden" name="id" value="{{id}}">
                <input type="hidden" name="csrf_token" value="{{csrfToken}}">

                <label for="nombre">Nombre</label>
                <input id="nombre" name="nombre" type="text" value="{{nombre}}" maxlength="50" required>

                <label for="usuario">Nombre de usuario</label>
                <input id="usuario" name="usuario" type="text" value="{{usuario}}" minlength="3" maxlength="255" required>

                <label for="email">Correo</label>
                <input id="email" name="email" type="email" value="{{email}}" maxlength="255" required>

                <label for="contrasena">Nueva contraseña (opcional)</label>
                <input id="contrasena" name="contrasena" type="password" minlength="8" autocomplete="new-password">
                <span class="moderador-item-meta">Si la completás, debe tener al menos 8 caracteres.</span>

                <div class="admin-nacimiento-edicion">
                    <div>
                        <label for="anioNacimiento">Año de nacimiento</label>
                        <input id="anioNacimiento" name="anioNacimiento" type="number" value="{{anioNacimiento}}" min="{{anioMinimoNacimiento}}" max="{{anioActual}}" required>
                    </div>
                    <div>
                        <label for="mesNacimiento">Mes</label>
                        <select id="mesNacimiento" name="mesNacimiento" required>
                            <option value="" {{^mesNacimiento}}selected{{/mesNacimiento}} disabled>Elegí</option>
                            {{#meses}}<option value="{{valor}}" {{#selected}}selected{{/selected}}>{{etiqueta}}</option>{{/meses}}
                        </select>
                    </div>
                    <div>
                        <label for="diaNacimiento">Día</label>
                        <select id="diaNacimiento" name="diaNacimiento" required>
                            <option value="" {{^diaNacimiento}}selected{{/diaNacimiento}} disabled>Elegí</option>
                            {{#dias}}<option value="{{valor}}" {{#selected}}selected{{/selected}}>{{etiqueta}}</option>{{/dias}}
                        </select>
                    </div>
                </div>

                <label for="sexo">Sexo</label>
                <select id="sexo" name="sexo">
                    {{#sexos}}<option value="{{value}}" {{#seleccionado}}selected{{/seleccionado}}>{{label}}</option>{{/sexos}}
                </select>

                <label for="provincia">Provincia</label>
                <input id="provincia" name="provincia" type="text" value="{{provincia}}" maxlength="150" required>

                <label for="pais">País</label>
                <input id="pais" name="pais" type="text" value="{{pais}}" maxlength="150" required>

                <label for="rol">Rol</label>
                {{#rolFijoAdmin}}
                    <input type="hidden" name="rol" value="ADMIN">
                    <p class="admin-rol-fijo">Administrador (único)</p>
                {{/rolFijoAdmin}}
                {{^rolFijoAdmin}}
                    <select id="rol" name="rol">
                        {{#roles}}
                            <option value="{{value}}" {{#seleccionado}}selected{{/seleccionado}}>{{label}}</option>
                        {{/roles}}
                    </select>
                {{/rolFijoAdmin}}

                <label class="moderador-correccion-radio admin-check-card" for="verificado">
                    <input id="verificado" name="verificado" type="checkbox" value="1" {{#verificado}}checked{{/verificado}}>
                    <span class="admin-check-copy">
                        <strong>Correo verificado</strong>
                        <small>Puede iniciar sesión en el sitio.</small>
                    </span>
                </label>

                <div class="moderador-acciones">
                    <button class="moderador-boton moderador-boton-resolver" type="submit">Guardar cambios</button>
                    <a class="moderador-boton moderador-boton-cancelar" href="{{basePath}}/admin/usuarios">Cancelar</a>
                </div>
                </form>
            </article>

            <aside class="moderador-correccion-contexto admin-foto-perfil" aria-labelledby="admin-foto-perfil-titulo">
                <h2 id="admin-foto-perfil-titulo">Imagen de perfil</h2>
                {{#fotoUrl}}
                    <img src="{{basePath}}/app/img-foto-perfil/{{fotoUrl}}" alt="Imagen de perfil de {{usuario}}">
                {{/fotoUrl}}
                {{^fotoUrl}}
                    <p>Este usuario no tiene imagen de perfil.</p>
                {{/fotoUrl}}
            </aside>
        </div>
    </div>
</main>
