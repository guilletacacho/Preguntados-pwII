<main class="moderador-shell">
    {{> navegacionLateral}}
    <div class="moderador-content">
        <header class="moderador-editor-encabezado">
            <a class="moderador-editor-volver" href="{{basePath}}/admin/usuarios">← Volver a usuarios</a>
            <span class="moderador-eyebrow">ADMINISTRACIÓN</span>
            <h1>{{usuario}}</h1>
            <p>Los datos los carga el usuario desde su perfil. Desde acá solo se puede cambiar el rol.</p>
        </header>
        {{> adminNavegacion}}

        {{#mensaje}}
            <p class="moderador-mensaje moderador-mensaje-{{tipo}}" role="alert">{{texto}}</p>
        {{/mensaje}}

        <div class="moderador-correccion-columnas admin-editar-usuario-columnas">
            <article class="moderador-correccion-formulario">
                <h2 class="admin-ficha-titulo">Datos de la cuenta</h2>
                <dl class="admin-ficha">
                    <div><dt>Nombre</dt><dd>{{nombre}}</dd></div>
                    <div><dt>Nombre de usuario</dt><dd>{{usuario}}</dd></div>
                    <div><dt>Correo</dt><dd>{{email}}</dd></div>
                    <div><dt>Nacimiento</dt><dd>{{fechaNacimiento}}</dd></div>
                    <div><dt>Sexo</dt><dd>{{sexoTexto}}</dd></div>
                    <div><dt>Ubicación</dt><dd>{{#provincia}}{{provincia}}, {{/provincia}}{{pais}}</dd></div>
                    <div><dt>Correo verificado</dt><dd>{{#verificado}}Sí{{/verificado}}{{^verificado}}No{{/verificado}}</dd></div>
                    <div><dt>Estado</dt><dd>{{#bloqueado}}<span class="admin-estado-bloqueado">Bloqueado</span>{{/bloqueado}}{{^bloqueado}}Activo{{/bloqueado}}</dd></div>
                    <div><dt>Alta</dt><dd>{{#fechaAlta}}{{fechaAlta}}{{/fechaAlta}}{{^fechaAlta}}Sin registro{{/fechaAlta}}</dd></div>
                </dl>

                <h2 class="admin-ficha-titulo">Rol</h2>
                {{#rolFijoAdmin}}
                    <p class="admin-rol-fijo">{{rolTexto}}</p>
                    <span class="moderador-item-meta">El rol de un administrador no se puede cambiar.</span>
                {{/rolFijoAdmin}}
                {{^rolFijoAdmin}}
                    <form class="admin-form-rol" method="post" action="{{basePath}}/admin/actualizarUsuario">
                        <input type="hidden" name="id" value="{{id}}">
                        <input type="hidden" name="csrf_token" value="{{csrfToken}}">
                        <label class="visually-hidden" for="rol">Rol de {{usuario}}</label>
                        <select id="rol" name="rol">
                            {{#roles}}
                                <option value="{{value}}" {{#seleccionado}}selected{{/seleccionado}}>{{label}}</option>
                            {{/roles}}
                        </select>
                        <div class="moderador-acciones">
                            <button class="moderador-boton moderador-boton-resolver" type="submit">Guardar rol</button>
                            <a class="moderador-boton moderador-boton-cancelar" href="{{basePath}}/admin/usuarios">Cancelar</a>
                        </div>
                    </form>
                {{/rolFijoAdmin}}
            </article>

            <aside class="moderador-correccion-contexto admin-foto-perfil" aria-labelledby="admin-foto-perfil-titulo">
                <h2 id="admin-foto-perfil-titulo">Imagen de perfil</h2>
                {{#fotoUrl}}
                    <img src="{{basePath}}/app/img-foto-perfil/{{fotoUrl}}" alt="Imagen de perfil de {{usuario}}">
                {{/fotoUrl}}
                {{^fotoUrl}}
                    <p>Este usuario no tiene imagen de perfil.</p>
                {{/fotoUrl}}
            </aside>
        </div>
    </div>
</main>
