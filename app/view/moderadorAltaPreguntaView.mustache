<main class="moderador-shell">
    <nav class="home-sidenav" aria-label="Secciones del sitio">
        <div class="home-side-menu">
            <button type="button" class="home-side-toggle" aria-label="Abrir o cerrar navegación" aria-expanded="false" aria-controls="moderador-alta-side-links"><span aria-hidden="true">☰</span><span class="side-label">Secciones</span></button>
            <div class="home-side-links" id="moderador-alta-side-links">
                <a href="{{basePath}}/home/show" aria-label="Inicio"><span aria-hidden="true">⌂</span><span class="side-label">Inicio</span></a>
                <a href="{{basePath}}/home/show#jugar" aria-label="Jugar"><span aria-hidden="true">▷</span><span class="side-label">Jugar</span></a>
                <a href="{{basePath}}/ranking" aria-label="Rankings"><span aria-hidden="true">☆</span><span class="side-label">Rankings</span></a>
                <a href="{{basePath}}/home/show#preguntas-frecuentes" aria-label="Preguntas frecuentes"><span aria-hidden="true">?</span><span class="side-label">Preguntas frecuentes</span></a>
                <a href="{{basePath}}/home/show#terminos" aria-label="Términos y condiciones"><span aria-hidden="true">§</span><span class="side-label">Términos y condiciones</span></a>
                <a href="{{basePath}}/moderador" aria-label="Panel moderador" aria-current="page"><span aria-hidden="true"><svg class="side-flag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4m0 1c5-4 9 4 14 0v11c-5 4-9-4-14 0"></path></svg></span><span class="side-label">Panel moderador</span></a>
            </div>
        </div>
    </nav>

    <div class="moderador-content">
        <header class="moderador-header">
            <div>
                <span class="moderador-eyebrow">PANEL MODERADOR</span>
                <h1>Nueva pregunta</h1>
                <p>Se suma al juego apenas la guardás.</p>
            </div>
            <button class="moderador-nueva-pregunta" type="button" aria-current="page">+ Nueva pregunta</button>
        </header>

        <nav class="moderador-tabs" aria-label="Secciones del panel">
            <a class="moderador-tab" href="{{basePath}}/moderador">Resumen</a>
            <a class="moderador-tab" href="{{basePath}}/moderador/reportes">Reportes <span class="moderador-badge moderador-badge-alerta">{{pendientes}}</span></a>
            <a class="moderador-tab" href="{{basePath}}/moderador/sugerencias">Sugerencias <span class="moderador-badge">{{sugerenciasPendientes}}</span></a>
            <a class="moderador-tab is-active" href="{{basePath}}/moderador/preguntas" aria-current="page">Preguntas</a>
        </nav>

        <form class="moderador-alta-formulario" method="post" enctype="multipart/form-data" action="{{basePath}}/moderador/crearPregunta">
            <input type="hidden" name="csrf_token" value="{{csrfToken}}">
            {{#error}}<p class="moderador-ayuda" role="alert">{{error}}</p>{{/error}}
            <div class="moderador-alta-grid">
                <div class="moderador-alta-columna">
                    <div class="moderador-alta-campo">
                        <label for="nueva-categoria">Categoría</label>
                        <select id="nueva-categoria" name="category_id" required>
                            <option value="" selected disabled>Seleccioná una categoría</option>
                            {{#categorias}}
                            <option value="{{id}}">{{name}}</option>
                            {{/categorias}}
                        </select>
                    </div>

                    <div class="moderador-alta-campo">
                        <label for="nueva-pregunta">Pregunta</label>
                        <textarea id="nueva-pregunta" name="question" rows="2" maxlength="500" required></textarea>
                    </div>

                    <fieldset class="moderador-respuestas">
                        <legend class="moderador-respuestas-titulo">Respuestas</legend>
                        <p class="moderador-ayuda">Marcá cuál es la correcta. Tienen que ser 4 y no se pueden repetir.</p>
                        <div class="moderador-respuesta">
                            <label class="visually-hidden" for="respuesta-a">Respuesta A</label>
                            <input class="moderador-respuesta-input" id="respuesta-a" name="responses[0][text]" type="text" placeholder="A" maxlength="255" required>
                            <label class="moderador-respuesta-correcta" for="correcta-a"><input id="correcta-a" name="responses[0][is_correct]" type="checkbox" value="1"> Correcta</label>
                        </div>
                        <div class="moderador-respuesta">
                            <label class="visually-hidden" for="respuesta-b">Respuesta B</label>
                            <input class="moderador-respuesta-input" id="respuesta-b" name="responses[1][text]" type="text" placeholder="B" maxlength="255" required>
                            <label class="moderador-respuesta-correcta" for="correcta-b"><input id="correcta-b" name="responses[1][is_correct]" type="checkbox" value="1"> Correcta</label>
                        </div>
                        <div class="moderador-respuesta">
                            <label class="visually-hidden" for="respuesta-c">Respuesta C</label>
                            <input class="moderador-respuesta-input" id="respuesta-c" name="responses[2][text]" type="text" placeholder="C" maxlength="255" required>
                            <label class="moderador-respuesta-correcta" for="correcta-c"><input id="correcta-c" name="responses[2][is_correct]" type="checkbox" value="1"> Correcta</label>
                        </div>
                        <div class="moderador-respuesta">
                            <label class="visually-hidden" for="respuesta-d">Respuesta D</label>
                            <input class="moderador-respuesta-input" id="respuesta-d" name="responses[3][text]" type="text" placeholder="D" maxlength="255" required>
                            <label class="moderador-respuesta-correcta" for="correcta-d"><input id="correcta-d" name="responses[3][is_correct]" type="checkbox" value="1"> Correcta</label>
                        </div>
                    </fieldset>
                </div>

                <fieldset class="moderador-alta-imagen">
                    <legend>Imagen de la pregunta (opcional)</legend>
                    <p class="moderador-ayuda">La imagen aparecerá junto al enunciado durante la partida. JPG o PNG, hasta 5 MB.</p>
                    <label for="nueva-imagen">Elegir imagen</label>
                    <input id="nueva-imagen" name="image" type="file" accept="image/jpeg,image/png" aria-describedby="nueva-imagen-ayuda">
                    <small id="nueva-imagen-ayuda">La vista previa se muestra aquí; la imagen se sube al crear la pregunta.</small>
                    <div class="moderador-alta-imagen-preview" id="nueva-imagen-preview-wrap" hidden>
                        <img id="nueva-imagen-preview" alt="Vista previa de la imagen seleccionada">
                    </div>
                    <p class="moderador-alta-imagen-nombre" id="nueva-imagen-nombre" aria-live="polite">Ninguna imagen seleccionada.</p>
                    <button class="moderador-alta-imagen-quitar" id="nueva-imagen-quitar" type="button" hidden>Quitar imagen</button>
                </fieldset>
            </div>

            <p class="moderador-dificultad-nota">Todas las preguntas nuevas se crean con dificultad fácil.</p>

            <div class="moderador-alta-acciones">
                <button class="moderador-alta-guardar" type="submit">Crear pregunta</button>
                <a href="{{basePath}}/moderador/preguntas">Cancelar</a>
            </div>
        </form>
    </div>
</main>
<script>
    document.querySelector('.moderador-shell .home-side-toggle').addEventListener('click', function () {
        const expanded = this.getAttribute('aria-expanded') !== 'true';
        this.setAttribute('aria-expanded', String(expanded));
        this.parentElement.classList.toggle('is-expanded', expanded);
    });
    document.querySelector('.moderador-shell .home-side-menu').addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            this.classList.remove('is-expanded');
            this.querySelector('button').setAttribute('aria-expanded', 'false');
            this.querySelector('button').focus();
        }
    });

    (function () {
        var input = document.getElementById('nueva-imagen');
        var previewWrap = document.getElementById('nueva-imagen-preview-wrap');
        var preview = document.getElementById('nueva-imagen-preview');
        var fileName = document.getElementById('nueva-imagen-nombre');
        var removeButton = document.getElementById('nueva-imagen-quitar');
        if (!input || !previewWrap || !preview || !fileName || !removeButton) return;

        var previewUrl = null;
        function clearImage() {
            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }
            input.value = '';
            preview.removeAttribute('src');
            previewWrap.hidden = true;
            removeButton.hidden = true;
            fileName.textContent = 'Ninguna imagen seleccionada.';
        }

        removeButton.addEventListener('click', clearImage);
        input.addEventListener('change', function () {
            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }

            var file = this.files && this.files[0];
            if (!file) {
                preview.removeAttribute('src');
                previewWrap.hidden = true;
                removeButton.hidden = true;
                fileName.textContent = 'Ninguna imagen seleccionada.';
                return;
            }

            if (!['image/jpeg', 'image/png'].includes(file.type) || file.size > 5 * 1024 * 1024) {
                this.value = '';
                preview.removeAttribute('src');
                previewWrap.hidden = true;
                removeButton.hidden = true;
                fileName.textContent = file.size > 5 * 1024 * 1024
                    ? 'La imagen no puede superar los 5 MB.'
                    : 'Elegí un archivo JPG o PNG.';
                return;
            }

            previewUrl = URL.createObjectURL(file);
            preview.src = previewUrl;
            previewWrap.hidden = false;
            removeButton.hidden = false;
            fileName.textContent = file.name;
        });
    })();
</script>
