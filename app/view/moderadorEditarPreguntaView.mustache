<main class="moderador-shell">
    <nav class="home-sidenav" aria-label="Secciones del sitio">
        <div class="home-side-menu">
            <button type="button" class="home-side-toggle" aria-label="Abrir o cerrar navegación" aria-expanded="false" aria-controls="moderador-editar-side-links">
                <span aria-hidden="true">☰</span><span class="side-label">Secciones</span>
            </button>
            <div class="home-side-links" id="moderador-editar-side-links">
                <a href="{{basePath}}/home/show" aria-label="Inicio"><span aria-hidden="true">⌂</span><span class="side-label">Inicio</span></a>
                <a href="{{basePath}}/home/show#jugar" aria-label="Jugar"><span aria-hidden="true">▷</span><span class="side-label">Jugar</span></a>
                <a href="{{basePath}}/ranking" aria-label="Rankings"><span aria-hidden="true">☆</span><span class="side-label">Rankings</span></a>
                <a href="{{basePath}}/home/show#preguntas-frecuentes" aria-label="Preguntas frecuentes"><span aria-hidden="true">?</span><span class="side-label">Preguntas frecuentes</span></a>
                <a href="{{basePath}}/home/show#terminos" aria-label="Términos y condiciones"><span aria-hidden="true">§</span><span class="side-label">Términos y condiciones</span></a>
                <a href="{{basePath}}/moderador" aria-label="Panel moderador" aria-current="page"><span aria-hidden="true"><svg class="side-flag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4m0 1c5-4 9 4 14 0v11c-5 4-9-4-14 0"></path></svg></span><span class="side-label">Panel moderador</span></a>
            </div>
        </div>
    </nav>

    <div class="moderador-content">
        <header class="moderador-editor-encabezado">
            <a class="moderador-editor-volver" href="{{basePath}}/moderador/preguntas">← Volver a preguntas</a>
            <p class="moderador-eyebrow">PANEL MODERADOR · PREGUNTA #{{editorQuestionId}}</p>
            <h1>Editar pregunta</h1>
            <p>Actualizá la categoría, el enunciado y las respuestas.</p>
        </header>

        {{#hayMensaje}}
            <p class="moderador-mensaje moderador-mensaje-{{mensaje.tipo}}" role="alert">{{mensaje.texto}}</p>
        {{/hayMensaje}}

        {{#editorDisponible}}
            <section class="moderador-correccion-formulario" aria-label="Formulario de edición de pregunta">
                <form method="post" enctype="multipart/form-data" action="{{basePath}}/moderador/actualizarPregunta">
                    <input type="hidden" name="question_id" value="{{editorQuestionId}}">
                    <input type="hidden" name="csrf_token" value="{{csrfToken}}">

                    <fieldset class="moderador-imagen-pregunta">
                        <legend>Imagen de la pregunta (opcional)</legend>
                        <label for="editar-imagen">Elegir una imagen nueva</label>
                        <input id="editar-imagen" name="image" type="file" accept="image/jpeg,image/png" aria-describedby="editar-imagen-ayuda">
                        <small id="editar-imagen-ayuda">JPG o PNG, hasta 5 MB.</small>
                        <p id="editar-imagen-nombre" aria-live="polite">Ninguna imagen nueva seleccionada.</p>
                        {{#hayEditorImagen}}
                            <label class="moderador-quitar-imagen"><input type="checkbox" name="remove_image" value="1" id="quitar-imagen-pregunta"> Quitar la imagen actual</label>
                        {{/hayEditorImagen}}
                    </fieldset>

                    <label for="editar-categoria">Categoría</label>
                    <select id="editar-categoria" name="category_id" required>
                        {{#editorCategorias}}
                            <option value="{{id}}" {{#seleccionada}}selected{{/seleccionada}}>{{name}}</option>
                        {{/editorCategorias}}
                    </select>

                    <div class="moderador-enunciado-con-imagen{{#hayEditorImagen}} tiene-imagen{{/hayEditorImagen}}" id="moderador-enunciado-con-imagen">
                        <div class="moderador-enunciado-texto">
                            <label for="editar-enunciado">Enunciado de la pregunta</label>
                            <textarea id="editar-enunciado" name="question" maxlength="500" rows="3" required>{{editorPregunta}}</textarea>
                        </div>
                        <div class="moderador-enunciado-vista-previa">
                            {{#hayEditorImagen}}
                                <div class="moderador-imagen-actual" id="imagen-pregunta-actual-wrap">
                                    <img src="{{basePath}}/app/img-preguntas/{{editorImagen}}" alt="Imagen actual de la pregunta">
                                </div>
                            {{/hayEditorImagen}}
                            {{^hayEditorImagen}}<div id="imagen-pregunta-actual-wrap" hidden></div>{{/hayEditorImagen}}
                            <div class="moderador-imagen-nueva" id="editar-imagen-preview-wrap" hidden>
                                <img id="editar-imagen-preview" alt="Vista previa de la nueva imagen">
                            </div>
                        </div>
                    </div>

                    <fieldset class="moderador-correccion-opciones">
                        <legend>Respuestas <span>Elegí cuál es la correcta.</span></legend>
                        {{#editorOpciones}}
                            <div class="moderador-correccion-respuesta">
                                <label for="editar-respuesta-{{respuesta_id}}">{{letra}}</label>
                                <input type="hidden" name="responses[{{indice}}][id]" value="{{respuesta_id}}">
                                <input id="editar-respuesta-{{respuesta_id}}" class="moderador-correccion-texto" type="text" name="responses[{{indice}}][texto]" value="{{response}}" maxlength="255" required>
                                <label class="moderador-correccion-radio" for="editar-correcta-{{respuesta_id}}">
                                    <input id="editar-correcta-{{respuesta_id}}" type="radio" name="correct_response_id" value="{{respuesta_id}}" {{#seleccionada}}checked{{/seleccionada}} required>
                                    Correcta
                                </label>
                            </div>
                        {{/editorOpciones}}
                    </fieldset>

                    <div class="moderador-correccion-acciones">
                        <button class="moderador-boton moderador-boton-resolver" type="submit">Confirmar cambios</button>
                        <a class="moderador-boton moderador-boton-cancelar" href="{{basePath}}/moderador/preguntas">Cancelar</a>
                    </div>
                </form>
            </section>
        {{/editorDisponible}}
        {{^editorDisponible}}
            <p class="moderador-mensaje moderador-mensaje-error" role="alert">
                No se puede editar esta pregunta: debe tener cuatro respuestas y al menos una categoría disponible.
            </p>
        {{/editorDisponible}}
    </div>
</main>

<style>
    .moderador-imagen-pregunta{display:grid;gap:.55rem;margin:0 0 1.25rem;padding:1rem;border:1px solid var(--borde);border-radius:12px}
    .moderador-imagen-pregunta legend{padding:0 .35rem;font-weight:700}
    .moderador-imagen-pregunta input[type=file]{max-width:100%;color:var(--texto-sec)}
    .moderador-imagen-actual,.moderador-imagen-nueva{width:100%;overflow:hidden;border:1px solid var(--borde);border-radius:10px;background:var(--hundido)}
    .moderador-imagen-actual img,.moderador-imagen-nueva img{display:block;width:100%;max-width:100%;max-height:11rem;object-fit:contain}
    .moderador-imagen-pregunta small,.moderador-imagen-pregunta p{margin:0;color:var(--texto-sec);font-size:.85rem}
    .moderador-quitar-imagen{display:flex;align-items:center;gap:.5rem}
    .moderador-enunciado-con-imagen{display:grid;grid-template-columns:minmax(0,1fr);gap:1rem;align-items:start}
    .moderador-enunciado-con-imagen.tiene-imagen{grid-template-columns:minmax(0,1fr) minmax(180px,32%)}
    .moderador-enunciado-texto{display:grid;gap:.55rem;min-width:0}
    .moderador-enunciado-vista-previa{display:grid;gap:.5rem;min-width:0}
    .moderador-enunciado-vista-previa [hidden]{display:none}
    @media(max-width:700px){.moderador-enunciado-con-imagen.tiene-imagen{grid-template-columns:minmax(0,1fr)}.moderador-enunciado-vista-previa{max-width:320px}}
</style>
<script>
    document.querySelector('.moderador-shell .home-side-toggle').addEventListener('click', function () {
        var expanded = this.getAttribute('aria-expanded') !== 'true';
        this.setAttribute('aria-expanded', String(expanded));
        this.parentElement.classList.toggle('is-expanded', expanded);
    });
    document.querySelector('.moderador-shell .home-side-menu').addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            this.classList.remove('is-expanded');
            this.querySelector('button').setAttribute('aria-expanded', 'false');
            this.querySelector('button').focus();
        }
    });

    (function () {
        var input = document.getElementById('editar-imagen');
        var previewWrap = document.getElementById('editar-imagen-preview-wrap');
        var preview = document.getElementById('editar-imagen-preview');
        var fileName = document.getElementById('editar-imagen-nombre');
        var removeImage = document.getElementById('quitar-imagen-pregunta');
        var currentWrap = document.getElementById('imagen-pregunta-actual-wrap');
        var questionLayout = document.getElementById('moderador-enunciado-con-imagen');
        if (!input || !previewWrap || !preview || !fileName) return;

        function syncImageLayout() {
            if (questionLayout) {
                questionLayout.classList.toggle('tiene-imagen', (currentWrap && !currentWrap.hidden) || !previewWrap.hidden);
            }
        }

        var previewUrl = null;
        input.addEventListener('change', function () {
            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }
            var file = this.files && this.files[0];
            if (!file) {
                preview.removeAttribute('src');
                previewWrap.hidden = true;
                fileName.textContent = 'Ninguna imagen nueva seleccionada.';
                syncImageLayout();
                return;
            }
            if (removeImage) removeImage.checked = false;
            if (!['image/jpeg', 'image/png'].includes(file.type) || file.size > 5 * 1024 * 1024) {
                this.value = '';
                preview.removeAttribute('src');
                previewWrap.hidden = true;
                syncImageLayout();
                fileName.textContent = file.size > 5 * 1024 * 1024
                    ? 'La imagen no puede superar los 5 MB.'
                    : 'Elegí un archivo JPG o PNG.';
                return;
            }
            if (currentWrap && currentWrap.querySelector('img')) currentWrap.hidden = false;
            previewUrl = URL.createObjectURL(file);
            preview.src = previewUrl;
            previewWrap.hidden = false;
            fileName.textContent = file.name;
            syncImageLayout();
        });
        if (removeImage && currentWrap) {
            removeImage.addEventListener('change', function () {
                currentWrap.hidden = this.checked;
                syncImageLayout();
            });
        }
    })();
</script>
