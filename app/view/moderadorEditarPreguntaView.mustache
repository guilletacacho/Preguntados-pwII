<main class="moderador-shell">
    {{> navegacionLateral}}

    <div class="moderador-content">
        <header class="moderador-editor-encabezado">
            <a class="moderador-editor-volver" href="{{basePath}}/moderador/preguntas">← Volver a preguntas</a>
            <p class="moderador-eyebrow">Preguntados · Moderación · PREGUNTA #{{editorQuestionId}}</p>
            <h1>Editar pregunta</h1>
            <p>Actualizá la categoría, el enunciado y las respuestas.</p>
        </header>
        {{> moderadorNavegacion}}

        {{#hayMensaje}}
            <p class="moderador-mensaje moderador-mensaje-{{mensaje.tipo}}" role="alert">{{mensaje.texto}}</p>
        {{/hayMensaje}}

        {{#editorDisponible}}
            <form class="moderador-alta-layout moderador-editor-layout" method="post" enctype="multipart/form-data" action="{{basePath}}/moderador/actualizarPregunta" aria-label="Formulario de edición de pregunta">
                <input type="hidden" name="question_id" value="{{editorQuestionId}}">
                <input type="hidden" name="csrf_token" value="{{csrfToken}}">

                <div class="moderador-alta-formulario">
                    <div class="moderador-alta-columna">
                        <div class="moderador-alta-campo">
                            <label for="editar-categoria">Categoría</label>
                            <select id="editar-categoria" name="category_id" required>
                                {{#editorCategorias}}
                                    <option value="{{id}}" {{#seleccionada}}selected{{/seleccionada}}>{{name}}</option>
                                {{/editorCategorias}}
                            </select>
                        </div>

                        <div class="moderador-alta-campo">
                            <label for="editar-enunciado">Pregunta</label>
                            <textarea id="editar-enunciado" name="question" maxlength="500" rows="2" required>{{editorPregunta}}</textarea>
                        </div>

                        <fieldset class="moderador-correccion-opciones">
                            <legend>Respuestas <span>Elegí cuál es la correcta.</span></legend>
                            {{#editorOpciones}}
                                <div class="moderador-correccion-respuesta">
                                    <label for="editar-respuesta-{{respuesta_id}}">{{letra}}</label>
                                    <input type="hidden" name="responses[{{indice}}][id]" value="{{respuesta_id}}">
                                    <input id="editar-respuesta-{{respuesta_id}}" class="moderador-correccion-texto" type="text" name="responses[{{indice}}][texto]" value="{{response}}" maxlength="255" required>
                                    <label class="moderador-correccion-radio" for="editar-correcta-{{respuesta_id}}">
                                        <input id="editar-correcta-{{respuesta_id}}" type="radio" name="correct_response_id" value="{{respuesta_id}}" {{#seleccionada}}checked{{/seleccionada}} required>
                                        Correcta
                                    </label>
                                </div>
                            {{/editorOpciones}}
                        </fieldset>
                    </div>

                    <div class="moderador-alta-acciones moderador-correccion-acciones">
                        <button class="moderador-alta-guardar" type="submit">Confirmar cambios</button>
                        <a href="{{basePath}}/moderador/preguntas">Cancelar</a>
                    </div>
                </div>

                <fieldset class="moderador-alta-imagen moderador-editor-imagen">
                    <legend>Imagen de la pregunta (opcional)</legend>
                    <p class="moderador-ayuda">La imagen aparecerá junto al enunciado durante la partida. JPG o PNG, hasta 5 MB.</p>
                    <label for="editar-imagen">Elegir imagen</label>
                    <input id="editar-imagen" name="image" type="file" accept="image/jpeg,image/png" aria-describedby="editar-imagen-ayuda">
                    <small id="editar-imagen-ayuda">La vista previa se muestra aquí; la imagen se sube al guardar.</small>
                    <p id="editar-imagen-nombre" class="moderador-alta-imagen-nombre" aria-live="polite">Ninguna imagen nueva seleccionada.</p>
                    {{#hayEditorImagen}}
                        <label class="moderador-quitar-imagen"><input type="checkbox" name="remove_image" value="1" id="quitar-imagen-pregunta"> Quitar la imagen actual</label>
                    {{/hayEditorImagen}}
                    <div class="moderador-imagen-vistas">
                        {{#hayEditorImagen}}
                            <div class="moderador-alta-imagen-preview moderador-imagen-actual" id="imagen-pregunta-actual-wrap">
                                <img src="{{basePath}}/app/img-preguntas/{{editorImagen}}" alt="Imagen actual de la pregunta">
                            </div>
                        {{/hayEditorImagen}}
                        {{^hayEditorImagen}}<div class="moderador-alta-imagen-preview moderador-imagen-actual" id="imagen-pregunta-actual-wrap" hidden></div>{{/hayEditorImagen}}
                        <div class="moderador-alta-imagen-preview moderador-imagen-nueva" id="editar-imagen-preview-wrap" hidden>
                            <img id="editar-imagen-preview" alt="Vista previa de la nueva imagen">
                        </div>
                    </div>
                </fieldset>
            </form>
        {{/editorDisponible}}
        {{^editorDisponible}}
            <p class="moderador-mensaje moderador-mensaje-error" role="alert">
                No se puede editar esta pregunta: debe tener cuatro respuestas y al menos una categoría disponible.
            </p>
        {{/editorDisponible}}
    </div>
</main>

<style>
    .moderador-editor-layout textarea { resize: none; }
    .moderador-editor-imagen { align-content: start; }
    .moderador-editor-imagen [hidden] { display: none; }
    .moderador-editor-imagen .moderador-imagen-vistas { display: grid; gap: 10px; min-width: 0; }
    .moderador-editor-imagen .moderador-alta-imagen-preview { height: 220px; }
    .moderador-editor-imagen .moderador-alta-imagen-preview img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
    .moderador-quitar-imagen { display: flex; align-items: center; gap: .5rem; color: var(--texto-sec); font-size: var(--moderador-texto-pequeno); }
    @media(max-width:700px){.moderador-editor-layout{grid-template-columns:minmax(0,1fr)}}
</style>
<script>

    (function () {
        var input = document.getElementById('editar-imagen');
        var previewWrap = document.getElementById('editar-imagen-preview-wrap');
        var preview = document.getElementById('editar-imagen-preview');
        var fileName = document.getElementById('editar-imagen-nombre');
        var removeImage = document.getElementById('quitar-imagen-pregunta');
        var currentWrap = document.getElementById('imagen-pregunta-actual-wrap');
        if (!input || !previewWrap || !preview || !fileName) return;

        var previewUrl = null;
        input.addEventListener('change', function () {
            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }
            var file = this.files && this.files[0];
            if (!file) {
                preview.removeAttribute('src');
                previewWrap.hidden = true;
                fileName.textContent = 'Ninguna imagen nueva seleccionada.';
                return;
            }
            if (removeImage) removeImage.checked = false;
            if (!['image/jpeg', 'image/png'].includes(file.type) || file.size > 5 * 1024 * 1024) {
                this.value = '';
                preview.removeAttribute('src');
                previewWrap.hidden = true;
                fileName.textContent = file.size > 5 * 1024 * 1024
                    ? 'La imagen no puede superar los 5 MB.'
                    : 'Elegí un archivo JPG o PNG.';
                return;
            }
            if (currentWrap && currentWrap.querySelector('img')) currentWrap.hidden = false;
            previewUrl = URL.createObjectURL(file);
            preview.src = previewUrl;
            previewWrap.hidden = false;
            fileName.textContent = file.name;
        });
        if (removeImage && currentWrap) {
            removeImage.addEventListener('change', function () {
                currentWrap.hidden = this.checked;
            });
        }
    })();
</script>
