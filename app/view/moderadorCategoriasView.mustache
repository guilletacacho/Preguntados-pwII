<main class="moderador-shell">
    <nav class="home-sidenav" aria-label="Secciones del sitio">
        <div class="home-side-menu">
            <button type="button" class="home-side-toggle" aria-label="Abrir o cerrar navegación" aria-expanded="false" aria-controls="moderador-categorias-side-links"><span aria-hidden="true">☰</span><span class="side-label">Secciones</span></button>
            <div class="home-side-links" id="moderador-categorias-side-links">
                <a href="{{basePath}}/home/show" aria-label="Inicio"><span aria-hidden="true">⌂</span><span class="side-label">Inicio</span></a>
                <a href="{{basePath}}/home/show#jugar" aria-label="Jugar"><span aria-hidden="true">▷</span><span class="side-label">Jugar</span></a>
                <a href="{{basePath}}/ranking" aria-label="Rankings"><span aria-hidden="true">☆</span><span class="side-label">Rankings</span></a>
                <a href="{{basePath}}/home/show#preguntas-frecuentes" aria-label="Preguntas frecuentes"><span aria-hidden="true">?</span><span class="side-label">Preguntas frecuentes</span></a>
                <a href="{{basePath}}/home/show#terminos" aria-label="Términos y condiciones"><span aria-hidden="true">§</span><span class="side-label">Términos y condiciones</span></a>
                <a href="{{basePath}}/moderador" aria-label="Panel moderador" aria-current="page"><span aria-hidden="true"><svg class="side-flag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4m0 1c5-4 9 4 14 0v11c-5 4-9-4-14 0"></path></svg></span><span class="side-label">Panel moderador</span></a>
            </div>
        </div>
    </nav>

    <div class="moderador-content">
        <header class="moderador-header">
            <div>
                <span class="moderador-eyebrow">PANEL MODERADOR</span>
                <h1>Categorías</h1>
                <p>Cada categoría tiene su color y su personaje. Las preguntas se cargan desde Preguntas.</p>
            </div>
            <a class="moderador-nueva-pregunta" href="{{basePath}}/moderador/categorias">+ Nueva categoría</a>
        </header>

        <nav class="moderador-tabs" aria-label="Secciones del panel">
            <a class="moderador-tab" href="{{basePath}}/moderador">Resumen</a>
            <a class="moderador-tab" href="{{basePath}}/moderador/reportes">Reportes <span class="moderador-badge moderador-badge-alerta">{{pendientes}}</span></a>
            <a class="moderador-tab" href="{{basePath}}/moderador/sugerencias">Sugerencias <span class="moderador-badge">{{sugerenciasPendientes}}</span></a>
            <a class="moderador-tab" href="{{basePath}}/moderador/preguntas">Preguntas</a>
            <a class="moderador-tab is-active" href="{{basePath}}/moderador/categorias" aria-current="page">Categorías</a>
        </nav>

        <section class="moderador-categorias" aria-label="Administrar categorías">
            <ul class="moderador-categorias-lista">
                {{#categorias}}
                    <li class="moderador-categoria-item{{#editando}} is-editando{{/editando}}" style="--categoria-color: {{color}}">
                        <img src="{{basePath}}/public/img/{{icono}}" alt="">
                        <div>
                            <strong>{{name}}</strong>
                            <span>{{preguntas}} preguntas activas · {{color}}</span>
                        </div>
                        <a href="{{basePath}}/moderador/categorias?editar={{id}}">Editar</a>
                    </li>
                {{/categorias}}
            </ul>

            <form class="moderador-alta-formulario moderador-categoria-formulario" method="post" action="{{basePath}}/moderador/guardarCategoria" enctype="multipart/form-data">
                <h2>{{#formEditando}}Editar categoría{{/formEditando}}{{^formEditando}}Nueva categoría{{/formEditando}}</h2>
                {{#mensaje}}<p class="moderador-categoria-mensaje" role="status">{{mensaje}}</p>{{/mensaje}}
                {{#error}}<p class="moderador-ayuda moderador-categoria-error" role="alert">{{error}}</p>{{/error}}
                <input type="hidden" name="category_id" value="{{formId}}">

                <div class="moderador-alta-campo">
                    <label for="categoria-nombre">Nombre</label>
                    <input class="moderador-respuesta-input" id="categoria-nombre" name="name" type="text" maxlength="40" value="{{formNombre}}" required>
                </div>

                <div class="moderador-alta-campo">
                    <label for="categoria-color-hex">Color</label>
                    <div class="moderador-color">
                        <input id="categoria-color" type="color" value="{{formColor}}" aria-label="Elegir color">
                        <input class="moderador-respuesta-input" id="categoria-color-hex" name="color" type="text" value="{{formColor}}" pattern="#[0-9a-fA-F]{6}" maxlength="7" required>
                    </div>
                </div>

                <div class="moderador-alta-campo">
                    <label for="categoria-icono">Personaje (SVG)</label>
                    {{#formIcono}}
                        <img class="moderador-categoria-actual" src="{{basePath}}/public/img/{{formIcono}}" alt="Personaje actual">
                        <p class="moderador-ayuda">Subí otro solo si lo querés cambiar.</p>
                    {{/formIcono}}
                    <input id="categoria-icono" name="icono" type="file" accept=".svg,image/svg+xml"{{^formEditando}} required{{/formEditando}}>
                    <p class="moderador-ayuda">Hasta 300 KB, sin scripts ni imágenes externas.</p>
                </div>

                <div class="moderador-alta-acciones">
                    <button class="moderador-alta-guardar" type="submit">{{#formEditando}}Guardar cambios{{/formEditando}}{{^formEditando}}Crear categoría{{/formEditando}}</button>
                    {{#formEditando}}<a href="{{basePath}}/moderador/categorias">Cancelar</a>{{/formEditando}}
                </div>
            </form>
        </section>
    </div>
</main>
<script>
    // El selector de color y el campo hexadecimal muestran siempre el mismo valor.
    (function () {
        const selector = document.getElementById('categoria-color');
        const hex = document.getElementById('categoria-color-hex');
        selector.addEventListener('input', function () { hex.value = selector.value; });
        hex.addEventListener('input', function () {
            if (/^#[0-9a-fA-F]{6}$/.test(hex.value)) selector.value = hex.value.toLowerCase();
        });
    })();
    document.querySelector('.moderador-shell .home-side-toggle').addEventListener('click', function () {
        const expanded = this.getAttribute('aria-expanded') !== 'true';
        this.setAttribute('aria-expanded', String(expanded));
        this.parentElement.classList.toggle('is-expanded', expanded);
    });
    document.querySelector('.moderador-shell .home-side-menu').addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            this.classList.remove('is-expanded');
            this.querySelector('button').setAttribute('aria-expanded', 'false');
            this.querySelector('button').focus();
        }
    });
</script>
