<form method="post" action="/Preguntados/login/login">
                <div class="w3-row-padding">
                    <div class="w3-half">
                        <label><b>Usuario</b></label>
                        <input class="w3-input w3-border" type="text" name="usuario" required>
                    </div>
                    <div class="w3-half">
                        <label><b>Contraseña</b></label>
                        <input class="w3-input w3-border" type="password" name="password" required>
                    </div>
                </div>
                <button type="submit" class="w3-button btn-cancha w3-round w3-margin-top w3-padding-16">Ingresar</button>
            </form>