<main class="login-shell">
    <div class="login-page">
        <section class="login-hero">
            <div>
                <h1>Trivia para medirte con tus amigos.</h1>
                <p>Preguntas de geografía, cine y TV, ciencia, arte, historia y deporte. Cada acierto suma un punto y un solo error termina la partida.</p>
            </div>
            <ul class="personajes" aria-label="Categorías">
                <li><img src="{{basePath}}/public/img/personajes/geografia.svg" alt="Geografía" width="204" height="206"></li>
                <li><img src="{{basePath}}/public/img/personajes/cine.svg" alt="Cine y TV" width="204" height="206"></li>
                <li><img src="{{basePath}}/public/img/personajes/ciencia.svg" alt="Ciencia" width="204" height="206"></li>
                <li><img src="{{basePath}}/public/img/personajes/arte.svg" alt="Arte" width="204" height="206"></li>
                <li><img src="{{basePath}}/public/img/personajes/historia.svg" alt="Historia" width="204" height="206"></li>
                <li><img src="{{basePath}}/public/img/personajes/deporte.svg" alt="Deporte" width="204" height="206"></li>
            </ul>
        </section>

        <section class="login-form-side">
            <div class="card login-card">
                <div class="login-card-body">
                    <h2 class="mb-1">Iniciá sesión</h2>
                    <p class="helper mb-4">Con tu nombre de usuario y contraseña.</p>
                    {{#error}}
                        <div class="alert alert-danger" role="alert">{{error}}</div>
                    {{/error}}
                    {{#pendiente}}
                        <div class="alert alert-warning" role="alert">Te enviamos un correo de verificación. Revisa tu bandeja de entrada para activar tu cuenta.</div>
                    {{/pendiente}}
                    {{#verificado}}
                        <div class="alert alert-success" role="alert">¡Tu cuenta ha sido verificada! Ya puedes iniciar sesión.</div>
                    {{/verificado}}

                    <form method="post" action="{{basePath}}/login/login">
                        <div class="mb-3">
                            <label for="Usuario" class="form-label">Nombre de usuario</label>
                            <input class="form-control" id="Usuario" name="Usuario" type="text" placeholder="triviamaster_99" autocomplete="username">
                        </div>
                        <div class="mb-4">
                            <label for="Contrasena" class="form-label">Contraseña</label>
                            <input class="form-control" id="Contrasena" name="Contrasena" type="password" placeholder="Tu contraseña" autocomplete="current-password">
                        </div>
                        <button class="btn submit-btn w-100" type="submit">Entrar</button>
                    </form>
                    <hr class="my-4" style="border-color: var(--borde); opacity: 1;">
                    <p class="text-center helper mb-0">¿Todavía no tenés cuenta? <a class="register-link" href="{{basePath}}/registro">Registrate</a></p>
                </div>
            </div>
        </section>
    </div>
</main>
