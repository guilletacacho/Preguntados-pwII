<main class="login-shell">
    <div class="perfil-page">
        <aside class="perfil-credencial">
            <div class="perfil-identidad">
                <div class="perfil-foto">
                    {{#fotoUrl}}<img src="{{basePath}}/app/img-foto-perfil/{{fotoUrl}}?v={{fotoVersion}}" alt="Foto de {{nombre}}">{{/fotoUrl}}
                    {{^fotoUrl}}<span aria-hidden="true">{{inicial}}</span>{{/fotoUrl}}
                </div>
                <div>
                    <h1>{{nombre}}</h1>
                    <p class="perfil-usuario">@{{usuario}}</p>
                </div>
                <dl class="perfil-datos">
                    <div>
                        <dt><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-label="Ubicación"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg></dt>
                        <dd>{{ubicacion}}</dd>
                    </div>
                    {{#hayEdad}}
                    <div>
                        <dt><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14v8H5z"/><path d="M5 16h14M8 12V9m8 3V9"/><path d="M7 7v2m5-5v5m5-3v3"/></svg></dt>
                        <dd>{{edad}} años</dd>
                    </div>
                    {{/hayEdad}}
                    {{#juegaDesde}}
                    <div>
                        <dt><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-label="Juega desde"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg></dt>
                        <dd>Juega desde {{juegaDesde}}</dd>
                    </div>
                    {{/juegaDesde}}
                </dl>
                {{#esMiPerfil}}
                <a class="perfil-editar" href="{{basePath}}/perfil/editar">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16v4Z"/><path d="m13.5 6.5 4 4"/></svg>
                    Editar perfil
                </a>
                {{/esMiPerfil}}
            </div>

            <section class="perfil-qr" aria-labelledby="perfil-qr-titulo">
                <div class="cinta" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
                <div class="perfil-qr-cuerpo">
                    <div class="perfil-qr-codigo">
                        <img src="{{basePath}}/perfil/qr?usuario={{usuarioUrl}}" alt="Código QR del perfil de {{usuario}}" width="132" height="132">
                    </div>
                    <div>
                        <h2 id="perfil-qr-titulo">Abrí este perfil en otro dispositivo</h2>
                        <p>Escaneá el código con la cámara del celular.</p>
                    </div>
                </div>
                <div class="perfil-qr-acciones">
                    <button type="button" id="perfil-copiar" data-enlace="{{enlacePerfil}}">Copiar enlace</button>
                    <a href="{{basePath}}/perfil/qr?usuario={{usuarioUrl}}" download="perfil-{{usuario}}.png">Descargar QR</a>
                </div>
            </section>
        </aside>

        <section class="perfil-contenido" aria-label="Estadísticas">
            <dl class="perfil-numeros">
                <div><dt>Puntaje total</dt><dd>{{puntaje}}</dd></div>
                <div><dt>Puesto en el ranking histórico</dt><dd>{{#puesto}}{{puesto}}.º{{/puesto}}{{^puesto}}—{{/puesto}}</dd></div>
                <div><dt>Partidas jugadas</dt><dd>{{cantidadPartidas}}</dd></div>
            </dl>

            <div class="perfil-tablero">
            <section class="perfil-caminos" aria-labelledby="perfil-caminos-titulo">
                <div class="perfil-caminos-encabezado">
                    <h2 id="perfil-caminos-titulo">Cómo le fue en cada partida</h2>
                    {{#hayPartidas}}<p>Cada casillero es una pregunta. Las tachadas son las que erró.</p>{{/hayPartidas}}
                </div>
                {{#hayPartidas}}
                <ol class="perfil-camino-lista">
                    {{#partidas}}
                    <li class="perfil-camino{{#esMasLarga}} perfil-camino-destacado{{/esMasLarga}}">
                        <div class="perfil-camino-dato">
                            <strong><time class="fecha-partida" datetime="{{fechaUtc}}"></time></strong>
                            <span>{{puntos}}, {{detalle}}{{#esMasLarga}}, <em>la más larga</em>{{/esMasLarga}}</span>
                        </div>
                        <div class="perfil-camino-recorrido">
                            <span class="perfil-camino-largada" aria-hidden="true"></span>
                            {{#casilleros}}
                            <span class="perfil-camino-tramo" aria-hidden="true"></span>
                            <span class="perfil-casillero{{#errada}} perfil-casillero-errado{{/errada}}" style="--categoria: {{color}}; animation-delay: {{demora}}" title="{{titulo}}">
                                <img src="{{basePath}}/public/img/{{icono}}" alt="{{titulo}}">
                            </span>
                            {{/casilleros}}
                            <span class="perfil-camino-tramo" aria-hidden="true"></span>
                            <span class="perfil-fin {{finClase}}">{{fin}}</span>
                        </div>
                    </li>
                    {{/partidas}}
                </ol>
                {{/hayPartidas}}
                {{^hayPartidas}}
                <p class="perfil-vacio">Todavía no jugó ninguna partida.</p>
                {{/hayPartidas}}
            </section>

            <aside class="perfil-lateral">
                <section class="perfil-categorias" aria-labelledby="perfil-categorias-titulo">
                    <h2 id="perfil-categorias-titulo">Por categoría</h2>
                    <ul>
                        {{#categorias}}
                        <li{{^jugada}} class="perfil-categoria-pendiente"{{/jugada}}>
                            <img src="{{basePath}}/public/img/{{icono}}" alt="">
                            <strong>{{nombre}}</strong>
                            <span>{{cuenta}}</span>
                        </li>
                        {{/categorias}}
                    </ul>
                </section>

                {{#esMiPerfil}}
                <section class="perfil-donde">
                    <h2>Dónde juega</h2>
                    <div id="perfil-map" class="perfil-mapa ubicacion-mapa" data-pais="{{pais}}" data-provincia="{{provincia}}" role="application" aria-label="Mapa de OpenStreetMap"></div>
                    <p class="helper mt-2 mb-0 ubicacion-mapa-estado" aria-live="polite"></p>
                </section>
                {{/esMiPerfil}}
            </aside>
            </div>
        </section>
    </div>
</main>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="{{basePath}}/public/js/ubicacion-mapa.js" defer></script>
<script src="{{basePath}}/public/js/perfil.js" defer></script>

<script>
// Las partidas se guardan en UTC: se muestran en la hora del navegador, como "25 nov, 13:24".
document.querySelectorAll('.fecha-partida').forEach(function (elemento) {
    var fecha = new Date(elemento.dateTime);

    if (!Number.isNaN(fecha.getTime())) {
        var dia = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short' }).format(fecha).replace('.', '');
        var hora = new Intl.DateTimeFormat('es-AR', { hour: '2-digit', minute: '2-digit', hour12: false }).format(fecha);
        elemento.textContent = dia + ', ' + hora;
    }
});
</script>
